<BaseLayout
  title="World Sea & Air Port Codes (UN/LOCODE Freight Directory) — Ecom Resources"
  description="Instant UN/LOCODE seaport & airport cargo directory for Amazon FBA and 3PL freight forwarders. Lookup Yantian (CNYTN), Ningbo (CNNGB), LA (USLAX), Long Beach (USLGB), and major air hubs."
>
  <Header />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="w-full bg-white dark:bg-[#131924] border-b border-slate-200/80 dark:border-white/[0.06] py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-400">Information</span>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">World Port Codes (UN/LOCODE)</span>
    </div>
  </nav>

  <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8 flex-1">
    <!-- Header Hero Showcase -->
    <section class="bg-gradient-to-br from-white via-slate-50 to-cyan-50/30 dark:from-slate-950 dark:via-dark-card dark:to-[#0A1420] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-7 shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="w-10 h-10 rounded-xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold text-lg shrink-0">
              ⚓
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                  World Sea & Air Port Codes (UN/LOCODE)
                </h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 hidden sm:inline-block">
                  UN/CEFACT Standard
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Standard 5-letter UN/LOCODE freight directory of major container ports and air cargo hubs used in cross-border e-commerce, Amazon FBA shipping, and bills of lading.
              </p>
            </div>
          </div>
        </div>

        <!-- Quick Summary Stats -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0 self-start md:self-auto flex-wrap">
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Total Hubs</span>
            <span class="text-base font-bold text-slate-900 dark:text-white font-mono">{PORTS_AND_HUBS.length}</span>
          </div>
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Sea Ports</span>
            <span class="text-base font-bold text-blue-600 dark:text-blue-400 font-mono">{PORTS_AND_HUBS.filter(p => p.type === 'Sea Port').length}</span>
          </div>
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Air Cargo</span>
            <span class="text-base font-bold text-purple-600 dark:text-purple-400 font-mono">{PORTS_AND_HUBS.filter(p => p.type === 'Air Cargo').length}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Search & Type Filter Bar -->
    <section class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Live Keyword Search -->
        <div class="relative flex-1 min-w-0 max-w-md">
          <input
            type="search"
            id="port-search-input"
            placeholder="Search by code (e.g. CNYTN, USLAX), port name, country, or trade lane..."
            class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-slate-50 dark:bg-dark-elevated text-slate-900 dark:text-white placeholder-slate-400 border border-slate-200 dark:border-white/10 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange/30 transition-all"
            autocomplete="off"
            spellcheck="false"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Filter Count Indicator -->
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          <span>Showing <strong id="port-match-count" class="text-slate-900 dark:text-white">{PORTS_AND_HUBS.length}</strong> of {PORTS_AND_HUBS.length} hubs</span>
          <button
            type="button"
            id="reset-port-filter-btn"
            class="hidden text-brand-orange hover:underline font-semibold cursor-pointer"
          >
            Clear Search
          </button>
        </div>
      </div>

      <!-- Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-1 border-t border-slate-100 dark:border-white/[0.05]">
        <button
          type="button"
          data-filter="all"
          class="port-filter-btn active-port-filter px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-brand-orange text-white shadow-xs"
        >
          All Hubs ({PORTS_AND_HUBS.length})
        </button>
        <button
          type="button"
          data-filter="Sea Port"
          class="port-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap flex items-center gap-1.5"
        >
          <span>🚢 Sea Ports</span>
          <span class="text-[10px] px-1 py-0.2 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono font-bold">
            {PORTS_AND_HUBS.filter(p => p.type === 'Sea Port').length}
          </span>
        </button>
        <button
          type="button"
          data-filter="Air Cargo"
          class="port-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap flex items-center gap-1.5"
        >
          <span>✈️ Air Cargo</span>
          <span class="text-[10px] px-1 py-0.2 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400 font-mono font-bold">
            {PORTS_AND_HUBS.filter(p => p.type === 'Air Cargo').length}
          </span>
        </button>
        <button
          type="button"
          data-filter="China & Asia"
          class="port-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🇨🇳 China & Asia ({PORTS_AND_HUBS.filter(p => p.region === 'China & Asia').length})
        </button>
        <button
          type="button"
          data-filter="North America"
          class="port-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🇺🇸 North America ({PORTS_AND_HUBS.filter(p => p.region === 'North America').length})
        </button>
        <button
          type="button"
          data-filter="Europe"
          class="port-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🇪🇺 Europe ({PORTS_AND_HUBS.filter(p => p.region === 'Europe').length})
        </button>
      </div>
    </section>

    <!-- Reference Table Container -->
    <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-2xl overflow-hidden shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-50/90 dark:bg-white/[0.03] border-b border-slate-200/80 dark:border-white/[0.06] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider text-[11px]">
              <th scope="col" class="py-3 px-3 sm:px-4">UN/LOCODE</th>
              <th scope="col" class="py-3 px-3.5 sm:px-4">Port / Hub Name</th>
              <th scope="col" class="py-3 px-3">Country</th>
              <th scope="col" class="py-3 px-3">Type</th>
              <th scope="col" class="py-3 px-3.5 sm:px-4 hidden lg:table-cell">Trade Lane & FBA Application</th>
            </tr>
          </thead>
          <tbody id="port-table-body" class="divide-y divide-slate-100 dark:divide-white/[0.04]">
            {
              PORTS_AND_HUBS.map((port) => {
                const cleanCode = port.code.replace(/-A$/, '');
                const flagCode = port.countryCode.toLowerCase();
                const searchKeywords = `${port.code} ${cleanCode} ${port.name} ${port.facility} ${port.country} ${port.type} ${port.tradeLane} ${port.region} ${port.fbaRelevance}`.toLowerCase();
                const isAir = port.type === 'Air Cargo';

                return (
                  <tr
                    class="port-row hover:bg-slate-50/80 dark:hover:bg-white/[0.02] transition-colors group"
                    data-search={searchKeywords}
                    data-type={port.type}
                    data-region={port.region}
                  >
                    <!-- UN/LOCODE with 1-click copy -->
                    <td class="py-3 px-3 sm:px-4 font-mono font-bold">
                      <button
                        type="button"
                        class="copy-port-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-white/[0.06] hover:bg-brand-orange/15 hover:text-brand-orange dark:hover:bg-brand-orange/20 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer font-bold text-xs group"
                        data-copy={cleanCode}
                        title={`Click to copy code: ${cleanCode}`}
                      >
                        <span class="tracking-wide text-slate-900 dark:text-white group-hover:text-brand-orange">{cleanCode}</span>
                        <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </td>

                    <!-- Port / Hub Name -->
                    <td class="py-3 px-3.5 sm:px-4 font-semibold text-slate-900 dark:text-white">
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="text-xs sm:text-sm group-hover:text-brand-orange transition-colors">
                            {port.name}
                          </span>
                          {port.isTopGateway && (
                            <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 hidden sm:inline-block">
                              Top Hub
                            </span>
                          )}
                        </div>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-normal block truncate max-w-sm">
                          {port.facility}
                        </span>
                      </div>
                    </td>

                    <!-- Country with Flag -->
                    <td class="py-3 px-3">
                      <div class="flex items-center gap-2">
                        <div class="w-5 h-3.5 rounded-2xs overflow-hidden shadow-2xs border border-black/10 dark:border-white/10 shrink-0">
                          <img
                            src={`https://flagcdn.com/w40/${flagCode}.png`}
                            srcset={`https://flagcdn.com/w80/${flagCode}.png 2x`}
                            alt={`${port.country} flag`}
                            class="w-full h-full object-cover select-none"
                            loading="lazy"
                          />
                        </div>
                        <span class="text-xs text-slate-700 dark:text-slate-300 whitespace-nowrap">
                          {port.country}
                        </span>
                      </div>
                    </td>

                    <!-- Facility Type Badge -->
                    <td class="py-3 px-3">
                      <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold ${
                        isAir
                          ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20'
                          : 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20'
                      }`}>
                        <span>{isAir ? '✈️' : '🚢'}</span>
                        <span>{port.type}</span>
                      </span>
                    </td>

                    <!-- Trade Lane & FBA Relevance -->
                    <td class="py-3 px-3.5 sm:px-4 hidden lg:table-cell text-xs text-slate-600 dark:text-slate-300">
                      <div>
                        <span class="font-semibold text-slate-800 dark:text-slate-200 block truncate">{port.tradeLane}</span>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 block truncate">{port.fbaRelevance}</span>
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <!-- No Results State -->
      <div id="no-port-results" class="hidden p-8 text-center">
        <div class="text-3xl mb-2">🔍</div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">No port codes found</h3>
        <p class="text-xs text-slate-400 mt-1">Try searching by UN/LOCODE (e.g. CNYTN, USLAX), port name, country, or trade lane.</p>
      </div>
    </div>

    <!-- Educational Freight & Transit Knowledge Cards -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-200/80 dark:border-white/[0.08]">
      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-brand-orange">🚢</span>
          <span>Transpacific Sea Transit Guide</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Standard ocean transit from Yantian/Ningbo to US West Coast (LA/Long Beach) is <strong>11–14 days</strong>; all-water to US East Coast (Savannah/NY) via Panama Canal is <strong>24–30 days</strong>.
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-cyan-500">📜</span>
          <span>Decoding UN/LOCODE Syntax</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          A UN/LOCODE is 5 alphanumeric characters: the first 2 letters designate the country (ISO 3166-1, e.g. <code class="font-mono text-cyan-600">CN</code>), and the remaining 3 identify the port (<code class="font-mono text-cyan-600">YTN</code> for Yantian).
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-purple-500">✈️</span>
          <span>Air Freight vs Sea Container</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Major air hubs like <code class="font-mono text-purple-500">PVG</code> and <code class="font-mono text-purple-500">HKG</code> provide 3–5 day airport-to-door delivery for urgent product launches and holiday stockouts.
        </p>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Instant Search, Pill Filter, and 1-Click Copy Script -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('port-search-input');
      const tableBody = document.getElementById('port-table-body');
      const rows = tableBody ? Array.from(tableBody.querySelectorAll('.port-row')) : [];
      const matchCountEl = document.getElementById('port-match-count');
      const resetBtn = document.getElementById('reset-port-filter-btn');
      const noResultsEl = document.getElementById('no-port-results');
      const filterPills = document.querySelectorAll('.port-filter-btn');

      let currentFilter = 'all';
      let currentQuery = '';

      function filterTable() {
        const query = currentQuery.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          const rowSearch = row.getAttribute('data-search') || '';
          const rowType = row.getAttribute('data-type') || '';
          const rowRegion = row.getAttribute('data-region') || '';

          let matchesFilter = false;
          if (currentFilter === 'all') {
            matchesFilter = true;
          } else if (currentFilter === 'Sea Port' || currentFilter === 'Air Cargo') {
            matchesFilter = rowType === currentFilter;
          } else {
            matchesFilter = rowRegion === currentFilter;
          }

          const matchesQuery = !query || rowSearch.includes(query);

          if (matchesFilter && matchesQuery) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (matchCountEl) {
          matchCountEl.textContent = String(visibleCount);
        }

        if (noResultsEl) {
          noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (resetBtn) {
          resetBtn.style.display = query || currentFilter !== 'all' ? 'inline-block' : 'none';
        }
      }

      // Search input event
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterTable();
        });
      }

      // Filter pills events
      filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          filterPills.forEach((p) => {
            p.classList.remove('active-port-filter', 'bg-brand-orange', 'text-white', 'shadow-xs');
            p.classList.add('text-slate-600', 'dark:text-slate-300');
          });

          pill.classList.add('active-port-filter', 'bg-brand-orange', 'text-white', 'shadow-xs');
          pill.classList.remove('text-slate-600', 'dark:text-slate-300');

          currentFilter = pill.getAttribute('data-filter') || 'all';
          filterTable();
        });
      });

      // Reset button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentFilter = 'all';
          filterPills.forEach((p, i) => {
            if (i === 0) {
              p.classList.add('active-port-filter', 'bg-brand-orange', 'text-white', 'shadow-xs');
              p.classList.remove('text-slate-600', 'dark:text-slate-300');
            } else {
              p.classList.remove('active-port-filter', 'bg-brand-orange', 'text-white', 'shadow-xs');
              p.classList.add('text-slate-600', 'dark:text-slate-300');
            }
          });
          filterTable();
        });
      }

      // Copy Code Button Logic
      const copyButtons = document.querySelectorAll('.copy-port-btn');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const val = btn.getAttribute('data-copy');
          if (!val) return;

          try {
            await navigator.clipboard.writeText(val);
            const originalHTML = btn.innerHTML;
            btn.innerHTML = `<span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Copied!</span>`;
            btn.classList.add('ring-2', 'ring-emerald-500/40', 'bg-emerald-50', 'dark:bg-emerald-950/40');

            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('ring-2', 'ring-emerald-500/40', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            }, 1400);
          } catch (err) {
            console.error('Failed to copy port code', err);
          }
        });
      });
    })();
  </script>
</BaseLayout>
