---

<BaseLayout
  title="Country & ISO Codes Directory (ISO 3166-1) — Ecom Resources"
  description="Searchable reference directory of 70+ cross-border e-commerce countries with official ISO-2, ISO-3, international dialing codes, and local currencies. Instant 1-click copy."
>
  <Header />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="w-full bg-white dark:bg-[#131924] border-b border-slate-200/80 dark:border-white/[0.06] py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-400">Information</span>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">Country & ISO Codes</span>
    </div>
  </nav>

  <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8 flex-1">
    <!-- Header Hero Showcase -->
    <section class="bg-gradient-to-br from-white via-slate-50 to-blue-50/30 dark:from-slate-950 dark:via-dark-card dark:to-[#0D1524] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-7 shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="w-10 h-10 rounded-xl bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg shrink-0">
              🌍
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                  Global Country & ISO Codes Directory
                </h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/30 hidden sm:inline-block">
                  ISO 3166-1
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Standard two-letter (Alpha-2), three-letter (Alpha-3), calling codes, and currency codes for international customs, Amazon FBA shipment labels, and carrier declarations.
              </p>
            </div>
          </div>
        </div>

        <!-- Quick Summary Stats -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0 self-start md:self-auto flex-wrap">
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Countries</span>
            <span class="text-base font-bold text-slate-900 dark:text-white font-mono">{COUNTRIES.length}</span>
          </div>
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Regions</span>
            <span class="text-base font-bold text-slate-900 dark:text-white font-mono">4</span>
          </div>
          <div class="bg-white/80 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 rounded-xl px-3 py-1.5 shadow-2xs text-center">
            <span class="text-xs text-slate-400 block font-medium">Currencies</span>
            <span class="text-base font-bold text-slate-900 dark:text-white font-mono">40+</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Search & Region Filters Bar -->
    <section class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Live Keyword Search -->
        <div class="relative flex-1 min-w-0 max-w-md">
          <input
            type="search"
            id="country-search-input"
            placeholder="Search by country, ISO (e.g. US, CN), dial code (+86), currency..."
            class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-slate-50 dark:bg-dark-elevated text-slate-900 dark:text-white placeholder-slate-400 border border-slate-200 dark:border-white/10 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange/30 transition-all"
            autocomplete="off"
            spellcheck="false"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Filter Count Indicator -->
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          <span>Showing <strong id="filter-match-count" class="text-slate-900 dark:text-white">{COUNTRIES.length}</strong> of {COUNTRIES.length} countries</span>
          <button
            type="button"
            id="reset-filter-btn"
            class="hidden text-brand-orange hover:underline font-semibold cursor-pointer"
          >
            Clear Search
          </button>
        </div>
      </div>

      <!-- Region Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-1 border-t border-slate-100 dark:border-white/[0.05]">
        <button
          type="button"
          data-region="All"
          class="region-tab-btn active-region-tab px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-brand-orange text-white shadow-xs"
        >
          All Regions ({COUNTRIES.length})
        </button>
        <button
          type="button"
          data-region="Asia-Pacific"
          class="region-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🌏 Asia-Pacific ({COUNTRIES.filter((c) => c.region === 'Asia-Pacific').length})
        </button>
        <button
          type="button"
          data-region="North America"
          class="region-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🌎 North America ({COUNTRIES.filter((c) => c.region === 'North America').length})
        </button>
        <button
          type="button"
          data-region="Europe"
          class="region-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🌍 Europe ({COUNTRIES.filter((c) => c.region === 'Europe').length})
        </button>
        <button
          type="button"
          data-region="Middle East & LATAM"
          class="region-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-all cursor-pointer whitespace-nowrap"
        >
          🌐 Middle East & LATAM ({COUNTRIES.filter((c) => c.region === 'Middle East & LATAM').length})
        </button>
      </div>
    </section>

    <!-- Reference Table Container -->
    <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-2xl overflow-hidden shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-50/90 dark:bg-white/[0.03] border-b border-slate-200/80 dark:border-white/[0.06] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider text-[11px]">
              <th scope="col" class="py-3 px-3.5 sm:px-4">Country / Territory</th>
              <th scope="col" class="py-3 px-3">ISO-2 (Alpha-2)</th>
              <th scope="col" class="py-3 px-3">ISO-3 (Alpha-3)</th>
              <th scope="col" class="py-3 px-3">Dialing Code</th>
              <th scope="col" class="py-3 px-3">Currency</th>
              <th scope="col" class="py-3 px-3.5 sm:px-4 hidden md:table-cell">Region & Hub Focus</th>
            </tr>
          </thead>
          <tbody id="country-table-body" class="divide-y divide-slate-100 dark:divide-white/[0.04]">
            {
              COUNTRIES.map((country) => {
                const flagCode = country.code.toLowerCase();
                const searchKeywords = `${country.name} ${country.code} ${country.iso3} ${country.dial} ${country.currency} ${country.region} ${country.hubType}`.toLowerCase();
                return (
                  <tr
                    class="country-row hover:bg-slate-50/80 dark:hover:bg-white/[0.02] transition-colors group"
                    data-search={searchKeywords}
                    data-region={country.region}
                  >
                    <!-- Country with Flag -->
                    <td class="py-3 px-3.5 sm:px-4 font-semibold text-slate-900 dark:text-white">
                      <div class="flex items-center gap-2.5">
                        <div class="w-6 h-4 rounded-2xs overflow-hidden shadow-2xs border border-black/10 dark:border-white/10 shrink-0">
                          <img
                            src={`https://flagcdn.com/w40/${flagCode}.png`}
                            srcset={`https://flagcdn.com/w80/${flagCode}.png 2x`}
                            alt={`${country.name} flag`}
                            class="w-full h-full object-cover select-none"
                            loading="lazy"
                          />
                        </div>
                        <span class="text-xs sm:text-sm group-hover:text-brand-orange transition-colors">
                          {country.name}
                        </span>
                        {country.isPopular && (
                          <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 hidden sm:inline-block">
                            Top Hub
                          </span>
                        )}
                      </div>
                    </td>

                    <!-- ISO-2 with 1-click copy -->
                    <td class="py-3 px-3 font-mono font-bold text-slate-800 dark:text-slate-100">
                      <button
                        type="button"
                        class="copy-code-btn inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-slate-100 dark:bg-white/[0.06] hover:bg-brand-orange/15 hover:text-brand-orange dark:hover:bg-brand-orange/20 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer font-bold text-xs"
                        data-copy={country.code}
                        title={`Copy ISO-2 code: ${country.code}`}
                      >
                        <span>{country.code}</span>
                        <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </td>

                    <!-- ISO-3 with 1-click copy -->
                    <td class="py-3 px-3 font-mono text-slate-700 dark:text-slate-300">
                      <button
                        type="button"
                        class="copy-code-btn inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-slate-100 dark:bg-white/[0.06] hover:bg-brand-orange/15 hover:text-brand-orange dark:hover:bg-brand-orange/20 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer font-bold text-xs"
                        data-copy={country.iso3}
                        title={`Copy ISO-3 code: ${country.iso3}`}
                      >
                        <span>{country.iso3}</span>
                        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </td>

                    <!-- Dial Code with 1-click copy -->
                    <td class="py-3 px-3 font-mono text-slate-600 dark:text-slate-300">
                      <button
                        type="button"
                        class="copy-code-btn inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-slate-100 dark:bg-white/[0.06] hover:bg-brand-orange/15 hover:text-brand-orange dark:hover:bg-brand-orange/20 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer text-xs"
                        data-copy={country.dial}
                        title={`Copy dial code: ${country.dial}`}
                      >
                        <span>{country.dial}</span>
                        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </td>

                    <!-- Currency Code & Symbol -->
                    <td class="py-3 px-3">
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                        <span>{country.currency}</span>
                        <span class="text-slate-400 font-normal">({country.currencySymbol})</span>
                      </span>
                    </td>

                    <!-- Region & Hub Focus -->
                    <td class="py-3 px-3.5 sm:px-4 hidden md:table-cell text-slate-500 dark:text-slate-400 text-xs">
                      <div>
                        <span class="font-medium text-slate-700 dark:text-slate-300">{country.region}</span>
                        <span class="text-[11px] text-slate-400 block truncate">{country.hubType}</span>
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <!-- No Results State -->
      <div id="no-country-results" class="hidden p-8 text-center">
        <div class="text-3xl mb-2">🔍</div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">No countries found</h3>
        <p class="text-xs text-slate-400 mt-1">Try searching by country name, ISO code (e.g. US, CN), dial code, or currency.</p>
      </div>
    </div>

    <!-- Quick Customs & Logistics Knowledge Section -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-200/80 dark:border-white/[0.08]">
      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-brand-orange">📦</span>
          <span>ISO-2 in Carrier Shipping</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          FedEx, UPS, DHL, and YunExpress shipping labels require standard 2-letter ISO 3166-1 alpha-2 codes (e.g., <code class="font-mono text-brand-orange">US</code>, <code class="font-mono text-brand-orange">DE</code>) for automated address validation.
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-blue-500">📄</span>
          <span>ISO-3 in Customs Declarations</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Commercial Invoices, Bills of Lading, and customs documentation (US CBP, EU TARIC, UK HMRC) use 3-letter ISO-3 codes (<code class="font-mono text-blue-500">USA</code>, <code class="font-mono text-blue-500">CHN</code>, <code class="font-mono text-blue-500">GBR</code>) to classify country of origin.
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-xl p-4 shadow-2xs">
        <div class="flex items-center gap-2 mb-2 font-bold text-sm text-slate-900 dark:text-white">
          <span class="text-emerald-500">⚡</span>
          <span>Direct 1-Click Copy</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Click any ISO-2, ISO-3, or international telephone dial code button to instantly copy the value to your clipboard with immediate visual confirmation.
        </p>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Instant Search, Region Tab Filter, and One-Click Copy Tooltip Logic -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('country-search-input');
      const tableBody = document.getElementById('country-table-body');
      const rows = tableBody ? Array.from(tableBody.querySelectorAll('.country-row')) : [];
      const matchCountEl = document.getElementById('filter-match-count');
      const resetBtn = document.getElementById('reset-filter-btn');
      const noResultsEl = document.getElementById('no-country-results');
      const regionTabs = document.querySelectorAll('.region-tab-btn');

      let currentRegion = 'All';
      let currentQuery = '';

      function filterTable() {
        const query = currentQuery.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          const rowSearch = row.getAttribute('data-search') || '';
          const rowRegion = row.getAttribute('data-region') || '';

          const matchesRegion = currentRegion === 'All' || rowRegion === currentRegion;
          const matchesQuery = !query || rowSearch.includes(query);

          if (matchesRegion && matchesQuery) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (matchCountEl) {
          matchCountEl.textContent = String(visibleCount);
        }

        if (noResultsEl) {
          noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (resetBtn) {
          resetBtn.style.display = query || currentRegion !== 'All' ? 'inline-block' : 'none';
        }
      }

      // Search event
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterTable();
        });
      }

      // Region tab events
      regionTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          regionTabs.forEach((t) => {
            t.classList.remove('active-region-tab', 'bg-brand-orange', 'text-white', 'shadow-xs');
            t.classList.add('text-slate-600', 'dark:text-slate-300');
          });

          tab.classList.add('active-region-tab', 'bg-brand-orange', 'text-white', 'shadow-xs');
          tab.classList.remove('text-slate-600', 'dark:text-slate-300');

          currentRegion = tab.getAttribute('data-region') || 'All';
          filterTable();
        });
      });

      // Reset button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentRegion = 'All';
          regionTabs.forEach((t, i) => {
            if (i === 0) {
              t.classList.add('active-region-tab', 'bg-brand-orange', 'text-white', 'shadow-xs');
              t.classList.remove('text-slate-600', 'dark:text-slate-300');
            } else {
              t.classList.remove('active-region-tab', 'bg-brand-orange', 'text-white', 'shadow-xs');
              t.classList.add('text-slate-600', 'dark:text-slate-300');
            }
          });
          filterTable();
        });
      }

      // Click to Copy Tooltip Handler
      const copyButtons = document.querySelectorAll('.copy-code-btn');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const val = btn.getAttribute('data-copy');
          if (!val) return;

          try {
            await navigator.clipboard.writeText(val);
            const originalHTML = btn.innerHTML;
            btn.innerHTML = `<span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Copied!</span>`;
            btn.classList.add('ring-2', 'ring-emerald-500/40', 'bg-emerald-50', 'dark:bg-emerald-950/40');

            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('ring-2', 'ring-emerald-500/40', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            }, 1400);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      });
    })();
  </script>
</BaseLayout>
