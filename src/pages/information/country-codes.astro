  { name: 'Slovakia', code: 'SK', iso3: 'SVK', dial: '+421', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Automotive & Electronics Parts' },
  { name: 'Bulgaria', code: 'BG', iso3: 'BGR', dial: '+359', currency: 'BGN', currencySymbol: 'лв', region: 'Europe', hubType: 'Southeast Europe Sourcing' },
  { name: 'Croatia', code: 'HR', iso3: 'HRV', dial: '+385', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Adriatic Shipping Gateway' },
  { name: 'Lithuania', code: 'LT', iso3: 'LTU', dial: '+370', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Baltic Logistics & FinTech' },
  { name: 'Slovenia', code: 'SI', iso3: 'SVN', dial: '+386', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Koper Port Maritime Hub' },
  { name: 'Latvia', code: 'LV', iso3: 'LVA', dial: '+371', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Baltic Fulfillment Node' },
  { name: 'Estonia', code: 'EE', iso3: 'EST', dial: '+372', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'E-Residency & Digital Commerce' },
  { name: 'Cyprus', code: 'CY', iso3: 'CYP', dial: '+357', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Eastern Mediterranean Shipping' },
  { name: 'Malta', code: 'MT', iso3: 'MLT', dial: '+356', currency: 'EUR', currencySymbol: '€', region: 'Europe', hubType: 'Mediterranean Free Port' },

  // 4. Middle East & LATAM
  { name: 'Mexico', code: 'MX', iso3: 'MEX', dial: '+52', currency: 'MXN', currencySymbol: '$', region: 'Middle East & LATAM', hubType: 'Nearshoring to US & Amazon MX', isPopular: true },
  { name: 'Brazil', code: 'BR', iso3: 'BRA', dial: '+55', currency: 'BRL', currencySymbol: 'R$', region: 'Middle East & LATAM', hubType: 'LATAM #1 E-Commerce Market', isPopular: true },
