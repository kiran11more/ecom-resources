---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

// 70+ Key Cross-Border E-Commerce, Sourcing & Manufacturing Countries
interface CountryCodeItem {
  name: string;
  code: string; // ISO-2
  iso3: string;
  dial: string;
  currency: string;
  currencySymbol: string;
  region: 'Asia-Pacific' | 'North America' | 'Europe' | 'Middle East & LATAM';
  hubType: string;
  isPopular?: boolean;
}

