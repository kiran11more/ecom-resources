---
import { DIRECTORY_RESOURCES, type DirectoryResource } from '../../data/resources';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ToolTile from '../../components/directory/ToolTile.astro';
import { getMonogram, getMonogramGradient } from '../../utils/monogram';

export async function getStaticPaths() {
  // CRITICAL: Only generate dedicated static detail pages for vetted platforms & tools where hasDetailPage === true
  const detailResources = DIRECTORY_RESOURCES.filter(
    (resource) => resource.hasDetailPage === true
  );

  return detailResources.map((resource) => ({
    params: { slug: resource.slug || resource.id },
    props: { resource },
  }));
}

interface Props {
  resource: DirectoryResource;
}

const { resource } = Astro.props;

// Related tools in the same category
const relatedResources = DIRECTORY_RESOURCES
  .filter((r) => r.categorySlug === resource.categorySlug && r.id !== resource.id)
  .slice(0, 3);

// Resolve clean official domain for favicon
let domain = resource.iconDomain || '';
if (!domain && resource.url && resource.url.startsWith('http')) {
  try {
    domain = new URL(resource.url).hostname.replace(/^www\./, '');
  } catch {}
}
const faviconUrl = domain
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128`
  : null;
---

<BaseLayout
  title={`${resource.name} — Review, Features & Official Guide | Ecom Resources`}
  description={resource.description}
>
  <Header />

  <!-- Breadcrumb Navigation Bar -->
  <div class="w-full bg-white dark:bg-[#131924] border-b border-slate-200/80 dark:border-white/[0.06] py-3">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 overflow-x-auto no-scrollbar">
      <a href="/" class="hover:text-brand-orange transition-colors shrink-0">Home</a>
      <span>/</span>
      <a href="/#directory-stream" class="hover:text-brand-orange transition-colors shrink-0">Directory</a>
      <span>/</span>
      <a href={`/#${resource.categorySlug}`} class="hover:text-brand-orange transition-colors shrink-0">{resource.category}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate">{resource.name}</span>
    </div>
  </div>

  <!-- Main Resource Detail Container -->
  <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8 flex-1">
    <!-- Back to Directory Quick Link -->
    <div>
      <a
        href="/#directory-stream"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-brand-orange hover:underline group"
      >
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span>Back to Full Resource Directory</span>
      </a>
    </div>

    <!-- Hero Showcase Card -->
    <section class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-3xl p-5 sm:p-8 shadow-xs relative overflow-hidden">
      <!-- Subtle top decorative gradient glow -->
      <div class="absolute -top-24 right-0 w-72 h-72 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 relative z-10">
        <div class="flex items-start gap-4 sm:gap-5 min-w-0 flex-1">
          <!-- 64px High-Res Brand Icon Container (Borderless per design system) -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-50 dark:bg-white/[0.05] p-2 flex items-center justify-center shrink-0 shadow-2xs relative overflow-hidden">
            {faviconUrl ? (
              <img
                src={faviconUrl}
                alt={`${resource.name} brand logo`}
                class="w-12 h-12 sm:w-14 sm:h-14 object-contain rounded-lg"
                loading="eager"
                onload="if (this.naturalHeight <= 16) { this.style.display='none'; this.nextElementSibling?.classList.remove('hidden'); }"
                onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
              />
            ) : null}
            <div class={`${faviconUrl ? 'hidden' : 'flex'} w-full h-full rounded-xl bg-gradient-to-br ${getMonogramGradient(resource.name)} items-center justify-center font-extrabold text-2xl text-white select-none`}>
              {getMonogram(resource.name)}
            </div>
          </div>

          <!-- Title, Verification & Category Info -->
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300">
                {resource.category}
              </span>
              {resource.isVerified && (
                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span>Verified Platform</span>
                </span>
              )}
              {resource.badge && (
                <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full border ${resource.badgeColor || 'bg-brand-orange/15 text-brand-orange border-brand-orange/30'}`}>
                  {resource.badge}
                </span>
              )}
            </div>

            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
              {resource.name}
            </h1>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              {resource.description}
            </p>
          </div>
        </div>

        <!-- Primary Call to Action Button & Domain -->
        <div class="flex flex-col sm:flex-row md:flex-col items-stretch sm:items-center md:items-end gap-3 shrink-0 self-stretch md:self-auto pt-2 md:pt-0">
          <a
            href={resource.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange/90 shadow-md hover:shadow-lg transition-all"
          >
            <span>Visit Official Website</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          {domain && (
            <span class="text-xs font-mono text-slate-400 text-center md:text-right">
              {domain}
            </span>
          )}
        </div>
      </div>

      <!-- Quick Platform Metrics Bar -->
      <div class="mt-6 pt-5 border-t border-slate-100 dark:border-white/[0.06] grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-dark-elevated/40 border border-slate-200/60 dark:border-white/[0.04]">
          <span class="text-slate-400 block font-medium">Pricing Model</span>
          <span class="font-bold text-sm text-slate-900 dark:text-white mt-0.5 block">
            {resource.pricing || 'Free'}
          </span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-dark-elevated/40 border border-slate-200/60 dark:border-white/[0.04]">
          <span class="text-slate-400 block font-medium">Platform Rating</span>
          <span class="font-bold text-sm text-amber-500 mt-0.5 block">
            ★ {resource.rating || '4.8'} / 5.0
          </span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-dark-elevated/40 border border-slate-200/60 dark:border-white/[0.04]">
          <span class="text-slate-400 block font-medium">Vetting Status</span>
          <span class="font-bold text-sm text-emerald-600 dark:text-emerald-400 mt-0.5 block">
            Directory Approved
          </span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-dark-elevated/40 border border-slate-200/60 dark:border-white/[0.04]">
          <span class="text-slate-400 block font-medium">Category Hub</span>
          <span class="font-bold text-sm text-slate-900 dark:text-white mt-0.5 block truncate">
            {resource.category}
          </span>
        </div>
      </div>
    </section>

    <!-- In-Depth Overview & Features Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content Column (Overview & Features) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- In-Depth Review & Overview -->
        <section class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-3xl p-6 sm:p-7 shadow-xs space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-orange"></span>
            <span>Platform Overview & Seller Guide</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
            {resource.fullDescription || resource.description}
          </p>
        </section>

        <!-- Key Features & Capabilities -->
        {resource.features && resource.features.length > 0 && (
          <section class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span>Key Features & Operational Capabilities</span>
            </h2>

            <ul class="space-y-3 pt-1">
              {resource.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-200">
                  <span class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <!-- Sidebar Column (Best Practices & Quick Action) -->
      <div class="space-y-6">
        <!-- Seller Due Diligence Card -->
        <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-3xl p-5 sm:p-6 shadow-xs space-y-3">
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🛡️</span>
            <span>Seller Best Practices</span>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            When connecting third-party platforms or initiating wholesale factory orders, verify supplier trade assurance, request pre-production golden samples, and check API token permissions.
          </p>
          <div class="pt-2">
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs text-white bg-slate-900 dark:bg-white dark:text-slate-900 hover:bg-brand-orange dark:hover:bg-brand-orange dark:hover:text-white transition-all shadow-xs"
            >
              <span>Open {resource.name} ↗</span>
            </a>
          </div>
        </div>

        <!-- Directory Assurance Pill -->
        <div class="bg-gradient-to-br from-brand-orange/10 via-amber-500/5 to-transparent border border-brand-orange/20 rounded-3xl p-5 text-xs space-y-2">
          <span class="font-bold text-brand-orange block uppercase tracking-wider text-[11px]">
            Directory Quality Guarantee
          </span>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            Every tool listed in our verified directory is manually screened for authentic cross-border functionality, secure HTTPS standards, and real seller utility.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Category Resources -->
    {relatedResources.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-slate-200/80 dark:border-white/[0.06]">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">
            More Tools in {resource.category}
          </h2>
          <a
            href={`/#${resource.categorySlug}`}
            class="text-xs font-bold text-brand-orange hover:underline"
          >
            View Category Section →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedResources.map((rel) => (
            <div class="h-full">
              <ToolTile resource={rel} />
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
