---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="Cross-Border Measurement, Packaging & CBM Converter — Ecom Resources"
  description="Cross-border e-commerce measurement calculator. Convert inches to cm, lbs to kg, calculate carton CBM volume and air/ocean freight dimensional weight."
>
  <Header />

  <!-- Breadcrumbs -->
  <div class="w-full bg-white dark:bg-[#131924] border-b border-slate-200/80 dark:border-white/[0.06] py-3">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-brand-orange transition-colors">Tools</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">Measurement & CBM Converter</span>
    </div>
  </div>

  <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 flex-1">
    <!-- Tool Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200/90 dark:border-white/[0.08]">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-base shrink-0">
            📐
          </span>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Cross-Border Measurement & CBM Converter
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Precision conversions for packaging cartons, air/sea dimensional weight, FBA tier limits, and factory specifications.
        </p>
      </div>

      <!-- Tab Switcher Navigation -->
      <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-dark-elevated rounded-xl border border-slate-200/80 dark:border-white/[0.05] shrink-0 self-start sm:self-auto text-xs">
        <button
          type="button"
          data-conv-tab="tab-cbm"
          class="conv-tab-btn conv-tab-active px-3 py-1.5 rounded-lg font-bold transition-all cursor-pointer"
        >
          📦 Carton CBM & Weight
        </button>
        <button
          type="button"
          data-conv-tab="tab-length"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
        >
          📏 Length
        </button>
        <button
          type="button"
          data-conv-tab="tab-temp"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
        >
          🌡️ Temperature
        </button>
        <button
          type="button"
          data-conv-tab="tab-area"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
        >
          ⬛ Area
        </button>
      </div>
    </div>

    <!-- TAB 1: Carton CBM & Dimensional Weight Calculator (Default) -->
    <div id="tab-cbm" class="conv-tab-panel space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Input Form -->
        <div class="lg:col-span-7 bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-white/[0.05] pb-3">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📦</span>
              <span>Carton Dimensions & Master Pack Setup</span>
            </h2>

            <!-- Unit Toggle for Dimensions -->
            <div class="flex items-center bg-slate-100 dark:bg-dark-elevated rounded-lg p-0.5 text-xs font-bold">
              <button type="button" id="cbm-unit-cm" class="cbm-dim-unit px-2.5 py-1 rounded-md bg-white dark:bg-white/10 text-slate-900 dark:text-white shadow-2xs">cm</button>
              <button type="button" id="cbm-unit-in" class="cbm-dim-unit px-2.5 py-1 rounded-md text-slate-500 hover:text-slate-900 dark:hover:text-white">inches</button>
            </div>
          </div>

          <!-- 3-Cols: Length, Width, Height -->
          <div class="grid grid-cols-3 gap-3">
            <div class="space-y-1.5">
              <label for="cbm-length" class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Length</label>
              <div class="relative">
                <input
                  type="number"
                  id="cbm-length"
                  step="0.1"
                  min="0"
                  value="50"
                  class="w-full px-3 py-2 text-sm sm:text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                />
                <span class="dim-unit-label absolute right-2.5 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">cm</span>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="cbm-width" class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Width</label>
              <div class="relative">
                <input
                  type="number"
                  id="cbm-width"
                  step="0.1"
                  min="0"
                  value="40"
                  class="w-full px-3 py-2 text-sm sm:text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                />
                <span class="dim-unit-label absolute right-2.5 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">cm</span>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="cbm-height" class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Height</label>
              <div class="relative">
                <input
                  type="number"
                  id="cbm-height"
                  step="0.1"
                  min="0"
                  value="30"
                  class="w-full px-3 py-2 text-sm sm:text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                />
                <span class="dim-unit-label absolute right-2.5 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">cm</span>
              </div>
            </div>
          </div>

          <!-- Quantity of Cartons & Weight per Carton -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="space-y-1.5">
              <label for="cbm-count" class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Total Cartons / Boxes</label>
              <input
                type="number"
                id="cbm-count"
                min="1"
                value="20"
                class="w-full px-3 py-2 text-sm font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
              />
            </div>

            <div class="space-y-1.5">
              <label for="cbm-weight" class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Actual Weight per Carton (kg)</label>
              <input
                type="number"
                id="cbm-weight"
                step="0.1"
                min="0"
                value="12.5"
                class="w-full px-3 py-2 text-sm font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
              />
            </div>
          </div>
        </div>

        <!-- Output Analytics Card -->
        <div class="lg:col-span-5 space-y-4">
          <div class="bg-gradient-to-br from-indigo-600 via-indigo-700 to-slate-900 text-white rounded-2xl p-5 sm:p-6 shadow-md space-y-4">
            <span class="text-xs uppercase font-bold tracking-wider text-indigo-200 block">Freight Volume Summary</span>

            <div>
              <span class="text-xs text-indigo-100/80 block">Total Volume (CBM)</span>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-extrabold font-mono tracking-tight" id="out-cbm-total">1.200</span>
                <span class="text-sm font-bold text-indigo-200">CBM (m³)</span>
              </div>
              <span class="text-xs text-indigo-200 mt-0.5 block" id="out-cuft-total">≈ 42.38 Cubic Feet</span>
            </div>

            <div class="pt-3 border-t border-white/15 grid grid-cols-2 gap-3 text-xs">
              <div>
                <span class="text-indigo-200 block">Total Actual Gross:</span>
                <span class="font-mono font-bold text-base text-white mt-0.5 block" id="out-gross-weight">250.0 kg</span>
                <span class="text-[11px] text-indigo-200/80" id="out-gross-lbs">≈ 551.2 lbs</span>
              </div>
              <div>
                <span class="text-indigo-200 block">Air Express Volumetric:</span>
                <span class="font-mono font-bold text-base text-white mt-0.5 block" id="out-dim-weight">240.0 kg</span>
                <span class="text-[11px] text-indigo-200/80">DIM Factor 5000</span>
              </div>
            </div>
          </div>

          <!-- Freight Classification Guide -->
          <div class="p-4 rounded-xl bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] text-xs space-y-2">
            <span class="font-bold text-slate-900 dark:text-white block">✈️ Freight Chargeable Weight Rule:</span>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
              Air freight and international couriers (DHL, FedEx, UPS) charge based on the <strong>greater</strong> of Actual Gross Weight vs. Volumetric (Dimensional) Weight.
            </p>
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-dark-elevated flex items-center justify-between font-mono font-bold text-slate-800 dark:text-white">
              <span>Chargeable Weight:</span>
              <span class="text-brand-orange text-sm" id="out-chargeable-weight">250.0 kg (Actual)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: Length / Distance Converter -->
    <div id="tab-length" class="conv-tab-panel hidden space-y-6">
      <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-white/[0.05] pb-3">
          <span>📏</span>
          <span>Length & Distance Conversion</span>
        </h2>

        <div class="flex flex-col sm:flex-row items-center gap-3">
          <input
            type="number"
            id="len-input-val"
            value="10"
            step="any"
            class="w-full sm:w-60 px-4 py-2.5 text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
          />
          <select
            id="len-input-unit"
            class="w-full sm:w-44 px-3 py-2.5 text-sm font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none"
          >
            <option value="in" selected>Inches (in)</option>
            <option value="cm">Centimeters (cm)</option>
            <option value="ft">Feet (ft)</option>
            <option value="m">Meters (m)</option>
            <option value="mm">Millimeters (mm)</option>
          </select>
        </div>

        <!-- Equivalent Results Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-2 text-xs">
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Inches</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-len-in">10.00 in</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Centimeters</span>
            <span class="text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 mt-1 block" id="out-len-cm">25.40 cm</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Feet</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-len-ft">0.83 ft</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Meters</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-len-m">0.254 m</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Millimeters</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-len-mm">254.0 mm</span>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: Temperature Converter -->
    <div id="tab-temp" class="conv-tab-panel hidden space-y-6">
      <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-white/[0.05] pb-3">
          <span>🌡️</span>
          <span>Temperature Conversion (°C / °F / K)</span>
        </h2>

        <div class="flex flex-col sm:flex-row items-center gap-3">
          <input
            type="number"
            id="temp-input-val"
            value="25"
            step="any"
            class="w-full sm:w-60 px-4 py-2.5 text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
          />
          <select
            id="temp-input-unit"
            class="w-full sm:w-44 px-3 py-2.5 text-sm font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none"
          >
            <option value="c" selected>Celsius (°C)</option>
            <option value="f">Fahrenheit (°F)</option>
            <option value="k">Kelvin (K)</option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10 text-center">
            <span class="text-xs text-slate-400 block font-medium">Celsius</span>
            <span class="text-2xl font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-temp-c">25.0 °C</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10 text-center">
            <span class="text-xs text-slate-400 block font-medium">Fahrenheit</span>
            <span class="text-2xl font-mono font-bold text-amber-500 mt-1 block" id="out-temp-f">77.0 °F</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10 text-center">
            <span class="text-xs text-slate-400 block font-medium">Kelvin</span>
            <span class="text-2xl font-mono font-bold text-blue-500 mt-1 block" id="out-temp-k">298.15 K</span>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: Area Converter -->
    <div id="tab-area" class="conv-tab-panel hidden space-y-6">
      <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-white/[0.05] pb-3">
          <span>⬛</span>
          <span>Surface Area Conversion</span>
        </h2>

        <div class="flex flex-col sm:flex-row items-center gap-3">
          <input
            type="number"
            id="area-input-val"
            value="100"
            step="any"
            class="w-full sm:w-60 px-4 py-2.5 text-base font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
          />
          <select
            id="area-input-unit"
            class="w-full sm:w-44 px-3 py-2.5 text-sm font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none"
          >
            <option value="sqft" selected>Square Feet (sq ft)</option>
            <option value="sqm">Square Meters (m²)</option>
            <option value="sqin">Square Inches (sq in)</option>
            <option value="sqcm">Square Centimeters (cm²)</option>
          </select>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Square Feet</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-area-sqft">100.00 sq ft</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Square Meters</span>
            <span class="text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 mt-1 block" id="out-area-sqm">9.29 m²</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Square Inches</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-area-sqin">14,400 sq in</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/70 dark:border-white/10">
            <span class="text-slate-400 block font-medium">Square Centimeters</span>
            <span class="text-base font-mono font-bold text-slate-900 dark:text-white mt-1 block" id="out-area-sqcm">92,903 cm²</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .conv-tab-active {
    background-color: #F25A2B !important;
    color: #ffffff !important;
    box-shadow: 0 1px 3px rgba(242, 90, 43, 0.35);
  }
</style>

<script is:inline>
  (() => {
    // 1. Tab Navigation
    const tabBtns = document.querySelectorAll('.conv-tab-btn');
    const panels = document.querySelectorAll('.conv-tab-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-conv-tab');
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.classList.remove('conv-tab-active');
          b.classList.add('text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('conv-tab-active');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');

        panels.forEach((p) => {
          p.classList.toggle('hidden', p.id !== targetId);
        });
      });
    });

    // 2. Carton CBM & Volumetric Calculator
    let currentDimUnit = 'cm'; // 'cm' or 'in'
    const btnCm = document.getElementById('cbm-unit-cm');
    const btnIn = document.getElementById('cbm-unit-in');
    const unitLabels = document.querySelectorAll('.dim-unit-label');

    const lenEl = document.getElementById('cbm-length');
    const widEl = document.getElementById('cbm-width');
    const hgtEl = document.getElementById('cbm-height');
    const cntEl = document.getElementById('cbm-count');
    const wgtEl = document.getElementById('cbm-weight');

    const outCbmTotal = document.getElementById('out-cbm-total');
    const outCuftTotal = document.getElementById('out-cuft-total');
    const outGrossWeight = document.getElementById('out-gross-weight');
    const outGrossLbs = document.getElementById('out-gross-lbs');
    const outDimWeight = document.getElementById('out-dim-weight');
    const outChargeableWeight = document.getElementById('out-chargeable-weight');

    function updateCbm() {
      let l = parseFloat(lenEl.value) || 0;
      let w = parseFloat(widEl.value) || 0;
      let h = parseFloat(hgtEl.value) || 0;
      const count = parseInt(cntEl.value, 10) || 0;
      const weightPerCarton = parseFloat(wgtEl.value) || 0;

      // Convert to cm if input is in inches
      const lCm = currentDimUnit === 'in' ? l * 2.54 : l;
      const wCm = currentDimUnit === 'in' ? w * 2.54 : w;
      const hCm = currentDimUnit === 'in' ? h * 2.54 : h;

      // Single carton volume in CBM
      const singleCbm = (lCm * wCm * hCm) / 1000000;
      const totalCbm = singleCbm * count;
      const totalCuft = totalCbm * 35.3147;

      // Actual Gross Weight in kg
      const totalGrossKg = weightPerCarton * count;
      const totalGrossLbs = totalGrossKg * 2.20462;

      // Air Express DIM weight in kg (L × W × H / 5000)
      const singleDimKg = (lCm * wCm * hCm) / 5000;
      const totalDimKg = singleDimKg * count;

      // Chargeable
      const chargeableKg = Math.max(totalGrossKg, totalDimKg);
      const isDimGreater = totalDimKg > totalGrossKg;

      if (outCbmTotal) outCbmTotal.textContent = totalCbm.toFixed(3);
      if (outCuftTotal) outCuftTotal.textContent = `≈ ${totalCuft.toFixed(2)} Cubic Feet`;
      if (outGrossWeight) outGrossWeight.textContent = `${totalGrossKg.toFixed(1)} kg`;
      if (outGrossLbs) outGrossLbs.textContent = `≈ ${totalGrossLbs.toFixed(1)} lbs`;
      if (outDimWeight) outDimWeight.textContent = `${totalDimKg.toFixed(1)} kg`;
      if (outChargeableWeight) {
        outChargeableWeight.textContent = `${chargeableKg.toFixed(1)} kg (${isDimGreater ? 'Volumetric' : 'Actual'})`;
      }
    }

    if (btnCm && btnIn) {
      btnCm.addEventListener('click', () => {
        if (currentDimUnit === 'cm') return;
        currentDimUnit = 'cm';
        btnCm.className = 'cbm-dim-unit px-2.5 py-1 rounded-md bg-white dark:bg-white/10 text-slate-900 dark:text-white shadow-2xs font-bold';
        btnIn.className = 'cbm-dim-unit px-2.5 py-1 rounded-md text-slate-500 hover:text-slate-900 dark:hover:text-white font-medium';
        unitLabels.forEach(l => l.textContent = 'cm');
        // Convert input numbers
        lenEl.value = (parseFloat(lenEl.value) * 2.54).toFixed(1);
        widEl.value = (parseFloat(widEl.value) * 2.54).toFixed(1);
        hgtEl.value = (parseFloat(hgtEl.value) * 2.54).toFixed(1);
        updateCbm();
      });

      btnIn.addEventListener('click', () => {
        if (currentDimUnit === 'in') return;
        currentDimUnit = 'in';
        btnIn.className = 'cbm-dim-unit px-2.5 py-1 rounded-md bg-white dark:bg-white/10 text-slate-900 dark:text-white shadow-2xs font-bold';
        btnCm.className = 'cbm-dim-unit px-2.5 py-1 rounded-md text-slate-500 hover:text-slate-900 dark:hover:text-white font-medium';
        unitLabels.forEach(l => l.textContent = 'in');
        // Convert input numbers
        lenEl.value = (parseFloat(lenEl.value) / 2.54).toFixed(1);
        widEl.value = (parseFloat(widEl.value) / 2.54).toFixed(1);
        hgtEl.value = (parseFloat(hgtEl.value) / 2.54).toFixed(1);
        updateCbm();
      });
    }

    [lenEl, widEl, hgtEl, cntEl, wgtEl].forEach(el => {
      if (el) el.addEventListener('input', updateCbm);
    });

    // 3. Length Converter
    const lenInputVal = document.getElementById('len-input-val');
    const lenInputUnit = document.getElementById('len-input-unit');
    const outLenIn = document.getElementById('out-len-in');
    const outLenCm = document.getElementById('out-len-cm');
    const outLenFt = document.getElementById('out-len-ft');
    const outLenM = document.getElementById('out-len-m');
    const outLenMm = document.getElementById('out-len-mm');

    function updateLength() {
      const val = parseFloat(lenInputVal.value) || 0;
      const unit = lenInputUnit.value;
      // Convert to meters first
      let inM = val;
      if (unit === 'in') inM = val * 0.0254;
      else if (unit === 'cm') inM = val * 0.01;
      else if (unit === 'ft') inM = val * 0.3048;
      else if (unit === 'mm') inM = val * 0.001;

      if (outLenIn) outLenIn.textContent = `${(inM / 0.0254).toFixed(2)} in`;
      if (outLenCm) outLenCm.textContent = `${(inM * 100).toFixed(2)} cm`;
      if (outLenFt) outLenFt.textContent = `${(inM / 0.3048).toFixed(2)} ft`;
      if (outLenM) outLenM.textContent = `${inM.toFixed(3)} m`;
      if (outLenMm) outLenMm.textContent = `${(inM * 1000).toFixed(1)} mm`;
    }

    if (lenInputVal && lenInputUnit) {
      lenInputVal.addEventListener('input', updateLength);
      lenInputUnit.addEventListener('change', updateLength);
    }

    // 4. Temperature Converter
    const tempInputVal = document.getElementById('temp-input-val');
    const tempInputUnit = document.getElementById('temp-input-unit');
    const outTempC = document.getElementById('out-temp-c');
    const outTempF = document.getElementById('out-temp-f');
    const outTempK = document.getElementById('out-temp-k');

    function updateTemp() {
      const val = parseFloat(tempInputVal.value) || 0;
      const unit = tempInputUnit.value;
      let c = val;
      if (unit === 'f') c = (val - 32) * (5 / 9);
      else if (unit === 'k') c = val - 273.15;

      const f = c * (9 / 5) + 32;
      const k = c + 273.15;

      if (outTempC) outTempC.textContent = `${c.toFixed(1)} °C`;
      if (outTempF) outTempF.textContent = `${f.toFixed(1)} °F`;
      if (outTempK) outTempK.textContent = `${k.toFixed(2)} K`;
    }

    if (tempInputVal && tempInputUnit) {
      tempInputVal.addEventListener('input', updateTemp);
      tempInputUnit.addEventListener('change', updateTemp);
    }

    // 5. Area Converter
    const areaInputVal = document.getElementById('area-input-val');
    const areaInputUnit = document.getElementById('area-input-unit');
    const outAreaSqft = document.getElementById('out-area-sqft');
    const outAreaSqm = document.getElementById('out-area-sqm');
    const outAreaSqin = document.getElementById('out-area-sqin');
    const outAreaSqcm = document.getElementById('out-area-sqcm');

    function updateArea() {
      const val = parseFloat(areaInputVal.value) || 0;
      const unit = areaInputUnit.value;
      let inSqm = val;
      if (unit === 'sqft') inSqm = val * 0.092903;
      else if (unit === 'sqin') inSqm = val * 0.00064516;
      else if (unit === 'sqcm') inSqm = val * 0.0001;

      if (outAreaSqft) outAreaSqft.textContent = `${(inSqm / 0.092903).toFixed(2)} sq ft`;
      if (outAreaSqm) outAreaSqm.textContent = `${inSqm.toFixed(2)} m²`;
      if (outAreaSqin) outAreaSqin.textContent = `${Math.round(inSqm / 0.00064516).toLocaleString()} sq in`;
      if (outAreaSqcm) outAreaSqcm.textContent = `${Math.round(inSqm * 10000).toLocaleString()} cm²`;
    }

    if (areaInputVal && areaInputUnit) {
      areaInputVal.addEventListener('input', updateArea);
      areaInputUnit.addEventListener('change', updateArea);
    }

    // Initialize all
    updateCbm();
    updateLength();
    updateTemp();
    updateArea();
  })();
</script>
