        <!-- Calculated CBM & Dim Weight Output -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-orange-500/10 border border-brand-orange/30">
            <span class="text-[11px] font-bold text-brand-orange block">Total Volume (CBM)</span>
            <span id="cbm-result-cbm" class="text-2xl font-mono font-black text-slate-900 dark:text-white">0.600 m³</span>
            <span class="text-[11px] text-slate-400 block mt-1">Single: 0.060 m³ / carton</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06]">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 block">Air Express Dim Wt (Div 5000)</span>
            <span id="cbm-result-air" class="text-2xl font-mono font-black text-slate-900 dark:text-white">120.0 kg</span>
            <span class="text-[11px] text-slate-400 block mt-1">12.0 kg / carton (DHL/FedEx)</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06]">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 block">Amazon US FBA Vol Wt (Div 139)</span>
            <span id="cbm-result-fba" class="text-2xl font-mono font-black text-slate-900 dark:text-white">264.5 lbs</span>
            <span class="text-[11px] text-slate-400 block mt-1">26.5 lbs / carton (Inches / 139)</span>
          </div>
