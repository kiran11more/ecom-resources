---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="Cross-Border Measurement Converter (Length, Temperature, Area, CBM) — Ecom Resources"
  description="Instant bidirectional e-commerce measurement calculator. Convert inches to cm, feet to meters, Celsius to Fahrenheit, sq ft to m², plus standard Amazon FBA packaging presets."
>
  <Header />

  <!-- Breadcrumbs -->
  <div class="w-full bg-white dark:bg-[#131924] border-b border-slate-200/80 dark:border-white/[0.06] py-3">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-brand-orange transition-colors">Tools</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">Measurement Converter</span>
    </div>
  </div>

  <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8 flex-1">
    <!-- Tool Header Showcase -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200/90 dark:border-white/[0.08]">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-base shrink-0">
            📐
          </span>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Cross-Border Measurement Converter
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Instant, bidirectional unit conversions for Amazon FBA package dimensions, factory specs, temperature limits, and carton volume.
        </p>
      </div>

      <!-- Tab Switcher Navigation -->
      <div class="flex items-center gap-1 p-1 bg-slate-100 dark:bg-dark-elevated rounded-xl border border-slate-200/80 dark:border-white/[0.05] shrink-0 self-start sm:self-auto text-xs overflow-x-auto no-scrollbar max-w-full">
        <button
          type="button"
          data-conv-tab="tab-length"
          class="conv-tab-btn conv-tab-active px-3 py-1.5 rounded-lg font-bold transition-all cursor-pointer whitespace-nowrap"
        >
          📏 Length & Distance
        </button>
        <button
          type="button"
          data-conv-tab="tab-temp"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer whitespace-nowrap"
        >
          🌡️ Temperature
        </button>
        <button
          type="button"
          data-conv-tab="tab-area"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer whitespace-nowrap"
        >
          ⬛ Surface Area
        </button>
        <button
          type="button"
          data-conv-tab="tab-cbm"
          class="conv-tab-btn px-3 py-1.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer whitespace-nowrap"
        >
          📦 Carton CBM & FBA
        </button>
      </div>
    </div>

    <!-- Quick E-Commerce Presets Bar -->
    <div class="bg-gradient-to-r from-orange-500/10 via-amber-500/5 to-transparent border border-brand-orange/30 rounded-2xl p-4 sm:p-5 space-y-2.5">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-orange flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Quick E-Commerce Presets (Click to Load)
        </span>
        <span class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:inline">Amazon FBA limits & warehouse standards</span>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
        <button
          type="button"
          data-preset-tab="tab-length"
          data-preset-unit="in"
          data-preset-val="18"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          📦 Amazon US Standard Size Max (18 in / 45.72 cm)
        </button>
        <button
          type="button"
          data-preset-tab="tab-length"
          data-preset-unit="in"
          data-preset-val="25"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          📐 Amazon FBA Max Carton Limit (25 in / 63.5 cm)
        </button>
        <button
          type="button"
          data-preset-tab="tab-length"
          data-preset-unit="in"
          data-preset-val="12"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          ✉️ Standard Polybag (12 in / 30.48 cm)
        </button>
        <button
          type="button"
          data-preset-tab="tab-length"
          data-preset-unit="in"
          data-preset-val="72"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          🏗️ Standard Pallet Max Height (72 in / 182.88 cm)
        </button>
        <button
          type="button"
          data-preset-tab="tab-temp"
          data-preset-unit="c"
          data-preset-val="40"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          🔥 Warehouse Heat Threshold (40°C / 104°F)
        </button>
        <button
          type="button"
          data-preset-tab="tab-temp"
          data-preset-unit="c"
          data-preset-val="4"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          ❄️ Cold-Chain Reefer Temp (4°C / 39.2°F)
        </button>
        <button
          type="button"
          data-preset-tab="tab-area"
          data-preset-unit="sqft"
          data-preset-val="13.33"
          class="preset-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#131924] border border-slate-200 dark:border-white/10 text-slate-800 dark:text-slate-200 hover:border-brand-orange hover:text-brand-orange shadow-2xs transition-all shrink-0 cursor-pointer"
        >
          🏢 GMA Pallet Footprint (13.33 ft² / 1.24 m²)
        </button>
      </div>
    </div>

    <!-- TAB 1: Length & Distance Converter (Bidirectional 6-Unit Grid) -->
    <div id="tab-length" class="conv-tab-panel space-y-6">
      <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 dark:border-white/[0.05] pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📏</span>
              <span>Length / Distance Converter</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Type in any input box to update all other units simultaneously in real time.
            </p>
          </div>
          <span class="text-xs text-brand-orange font-semibold bg-brand-orange/10 px-2.5 py-1 rounded-full self-start sm:self-auto">
            Instant Bidirectional Sync
          </span>
        </div>

        <!-- 6 Bidirectional Input Rows Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Inches -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Inches (in)</span>
              <span class="text-[10px] font-mono text-slate-400">US Standard</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-in"
                data-len-unit="in"
                value="25"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-in"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Inches"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 in = 2.54 cm</p>
          </div>

          <!-- Centimeters -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Centimeters (cm)</span>
              <span class="text-[10px] font-mono text-slate-400">Metric Factory</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-cm"
                data-len-unit="cm"
                value="63.5"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-cm"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Centimeters"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 cm = 0.3937 in</p>
          </div>

          <!-- Millimeters -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Millimeters (mm)</span>
              <span class="text-[10px] font-mono text-slate-400">Precision Specs</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-mm"
                data-len-unit="mm"
                value="635"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-mm"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Millimeters"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 mm = 0.03937 in</p>
          </div>

          <!-- Meters -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Meters (m)</span>
              <span class="text-[10px] font-mono text-slate-400">Freight & Ocean</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-m"
                data-len-unit="m"
                value="0.635"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-m"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Meters"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 m = 39.3701 in</p>
          </div>

          <!-- Feet -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Feet (ft)</span>
              <span class="text-[10px] font-mono text-slate-400">Pallet & Rack</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-ft"
                data-len-unit="ft"
                value="2.0833"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-ft"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Feet"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 ft = 12 in = 30.48 cm</p>
          </div>

          <!-- Yards -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Yards (yd)</span>
              <span class="text-[10px] font-mono text-slate-400">Textile & Fabric</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="len-yd"
                data-len-unit="yd"
                value="0.6944"
                class="len-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="len-yd"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Yards"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 yd = 3 ft = 36 in</p>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: Temperature Converter (Celsius, Fahrenheit, Kelvin) -->
    <div id="tab-temp" class="conv-tab-panel hidden space-y-6">
      <div class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 dark:border-white/[0.05] pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🌡️</span>
              <span>Temperature Converter</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Instant bidirectional conversion between Celsius (°C), Fahrenheit (°F), and Kelvin (K).
            </p>
          </div>
          <span class="text-xs text-brand-orange font-semibold bg-brand-orange/10 px-2.5 py-1 rounded-full self-start sm:self-auto">
            Cold-Chain & Warehouse Safety
          </span>
        </div>

        <!-- 3 Temperature Input Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Celsius -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Celsius (°C)</span>
              <span class="text-[10px] font-mono text-slate-400">Global Metric</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="temp-c"
                data-temp-unit="c"
                value="20"
                class="temp-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="0"
              />
              <button
                type="button"
                data-copy-target="temp-c"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Celsius"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">Water freezes: 0°C | Boils: 100°C</p>
          </div>

          <!-- Fahrenheit -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Fahrenheit (°F)</span>
              <span class="text-[10px] font-mono text-slate-400">US Standard</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="temp-f"
                data-temp-unit="f"
                value="68"
                class="temp-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="32"
              />
              <button
                type="button"
                data-copy-target="temp-f"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Fahrenheit"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">Water freezes: 32°F | Boils: 212°F</p>
          </div>

          <!-- Kelvin -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Kelvin (K)</span>
              <span class="text-[10px] font-mono text-slate-400">Scientific Base</span>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="number"
                step="any"
                id="temp-k"
                data-temp-unit="k"
                value="293.15"
                class="temp-input w-full px-3 py-2 text-base font-mono font-bold bg-white dark:bg-[#131924] rounded-lg border border-slate-300 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:border-brand-orange"
                placeholder="273.15"
              />
              <button
                type="button"
                data-copy-target="temp-k"
                class="unit-copy-btn px-2.5 py-2 rounded-lg bg-slate-200/80 dark:bg-white/10 hover:bg-brand-orange hover:text-white text-slate-700 dark:text-slate-200 text-xs font-bold transition-all shrink-0 cursor-pointer"
                title="Copy Kelvin"
              >
                Copy
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">Absolute zero: 0 K (-273.15°C)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: Surface Area Converter (cm², m², in², ft²) -->
    <div id="tab-area" class="conv-tab-panel hidden space-y-6">
