              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">1 m² = 10.7639 ft² = 10,000 cm²</p>
          </div>

          <!-- Sq Inches -->
          <div class="unit-card p-4 rounded-xl bg-slate-50 dark:bg-dark-elevated border border-slate-200/80 dark:border-white/[0.06] focus-within:border-brand-orange transition-all space-y-2">
            <div class="flex items-center justify-between">
