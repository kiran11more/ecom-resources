          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Carton Count</label>
            <input type="number" id="cbm-qty" value="10" step="1" min="1" class="w-full px-3 py-2 text-sm font-mono font-bold bg-slate-50 dark:bg-dark-elevated rounded-xl border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:border-brand-orange focus:outline-none" />
