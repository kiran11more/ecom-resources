<style>
  .conv-tab-active {
    background-color: #F25A2B !important;
    color: #ffffff !important;
    box-shadow: 0 1px 3px rgba(242, 90, 43, 0.35);
  }
</style>

<script is:inline>
  (() => {
    // ------------------------------------------------------------------------
    // TAB NAVIGATION
    // ------------------------------------------------------------------------
    const tabButtons = document.querySelectorAll('.conv-tab-btn');
    const tabPanels = document.querySelectorAll('.conv-tab-panel');

    function switchTab(targetTabId) {
      tabButtons.forEach(btn => {
        const isActive = btn.getAttribute('data-conv-tab') === targetTabId;
        btn.classList.toggle('conv-tab-active', isActive);
        if (!isActive) {
          btn.classList.remove('text-white');
          btn.classList.add('text-slate-600', 'dark:text-slate-300');
        } else {
          btn.classList.remove('text-slate-600', 'dark:text-slate-300');
          btn.classList.add('text-white');
        }
      });

      tabPanels.forEach(panel => {
        panel.classList.toggle('hidden', panel.id !== targetTabId);
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-conv-tab');
        if (tabId) switchTab(tabId);
      });
    });

    // ------------------------------------------------------------------------
    // COPY TO CLIPBOARD HELPER
    // ------------------------------------------------------------------------
    document.querySelectorAll('.unit-copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-copy-target');
        const input = document.getElementById(targetId);
        if (!input) return;

        const val = input.value;
        navigator.clipboard.writeText(val).then(() => {
          const originalText = btn.textContent;
          btn.textContent = '✓ Copied';
          btn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('bg-emerald-600', 'text-white');
          }, 1500);
        });
      });
    });

    // ------------------------------------------------------------------------
    // TAB 1: LENGTH BIDIRECTIONAL CONVERTER
    // Base unit: Meters (m)
    // ------------------------------------------------------------------------
    const lenFactors = {
      m: 1,
      cm: 0.01,
      mm: 0.001,
      in: 0.0254,
      ft: 0.3048,
      yd: 0.9144
    };

    const lenInputs = {
      m: document.getElementById('len-m'),
      cm: document.getElementById('len-cm'),
      mm: document.getElementById('len-mm'),
      in: document.getElementById('len-in'),
      ft: document.getElementById('len-ft'),
      yd: document.getElementById('len-yd')
    };

    function updateLengthFrom(sourceUnit, val) {
      if (isNaN(val) || val === '') {
        Object.keys(lenInputs).forEach(u => {
          if (u !== sourceUnit && lenInputs[u]) lenInputs[u].value = '';
        });
        return;
      }

      const num = parseFloat(val);
      const meters = num * lenFactors[sourceUnit];

      Object.keys(lenInputs).forEach(u => {
        if (u !== sourceUnit && lenInputs[u]) {
          const converted = meters / lenFactors[u];
          // Round nicely: avoid exponential and floating artifacts
          const rounded = parseFloat(converted.toFixed(6));
          lenInputs[u].value = rounded;
        }
      });
    }

    Object.keys(lenInputs).forEach(unit => {
      const el = lenInputs[unit];
      if (el) {
        el.addEventListener('input', (e) => {
          updateLengthFrom(unit, e.target.value);
        });
      }
    });

    // ------------------------------------------------------------------------
    // TAB 2: TEMPERATURE BIDIRECTIONAL CONVERTER
    // ------------------------------------------------------------------------
    const tempInputs = {
      c: document.getElementById('temp-c'),
      f: document.getElementById('temp-f'),
      k: document.getElementById('temp-k')
    };

    function updateTempFrom(sourceUnit, val) {
      if (isNaN(val) || val === '') {
        Object.keys(tempInputs).forEach(u => {
          if (u !== sourceUnit && tempInputs[u]) tempInputs[u].value = '';
        });
        return;
      }

      const num = parseFloat(val);
      let celsius = 0;

      if (sourceUnit === 'c') {
        celsius = num;
      } else if (sourceUnit === 'f') {
        celsius = (num - 32) * (5 / 9);
      } else if (sourceUnit === 'k') {
        celsius = num - 273.15;
      }

      if (sourceUnit !== 'c' && tempInputs.c) {
        tempInputs.c.value = parseFloat(celsius.toFixed(4));
      }
      if (sourceUnit !== 'f' && tempInputs.f) {
        const f = celsius * (9 / 5) + 32;
        tempInputs.f.value = parseFloat(f.toFixed(4));
      }
      if (sourceUnit !== 'k' && tempInputs.k) {
        const k = celsius + 273.15;
        tempInputs.k.value = parseFloat(k.toFixed(4));
      }
    }

    Object.keys(tempInputs).forEach(unit => {
      const el = tempInputs[unit];
      if (el) {
        el.addEventListener('input', (e) => {
          updateTempFrom(unit, e.target.value);
        });
      }
    });

    // ------------------------------------------------------------------------
    // TAB 3: SURFACE AREA BIDIRECTIONAL CONVERTER
    // Base unit: Square Meters (sqm)
    // ------------------------------------------------------------------------
    const areaFactors = {
      sqm: 1,
      sqcm: 0.0001,
      sqft: 0.09290304,
      sqin: 0.00064516
    };

    const areaInputs = {
      sqm: document.getElementById('area-sqm'),
      sqcm: document.getElementById('area-sqcm'),
      sqft: document.getElementById('area-sqft'),
      sqin: document.getElementById('area-sqin')
    };

    function updateAreaFrom(sourceUnit, val) {
      if (isNaN(val) || val === '') {
        Object.keys(areaInputs).forEach(u => {
          if (u !== sourceUnit && areaInputs[u]) areaInputs[u].value = '';
        });
        return;
      }

      const num = parseFloat(val);
      const sqMeters = num * areaFactors[sourceUnit];

      Object.keys(areaInputs).forEach(u => {
        if (u !== sourceUnit && areaInputs[u]) {
          const converted = sqMeters / areaFactors[u];
          areaInputs[u].value = parseFloat(converted.toFixed(6));
        }
      });
    }

    Object.keys(areaInputs).forEach(unit => {
      const el = areaInputs[unit];
      if (el) {
        el.addEventListener('input', (e) => {
          updateAreaFrom(unit, e.target.value);
        });
      }
    });

    // ------------------------------------------------------------------------
    // PRESETS BAR CLICK HANDLERS
    // ------------------------------------------------------------------------
    document.querySelectorAll('.preset-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const targetTab = pill.getAttribute('data-preset-tab');
        const unit = pill.getAttribute('data-preset-unit');
        const val = pill.getAttribute('data-preset-val');

        if (targetTab) switchTab(targetTab);

        if (targetTab === 'tab-length' && lenInputs[unit]) {
          lenInputs[unit].value = val;
          updateLengthFrom(unit, val);
          lenInputs[unit].focus();
        } else if (targetTab === 'tab-temp' && tempInputs[unit]) {
          tempInputs[unit].value = val;
          updateTempFrom(unit, val);
          tempInputs[unit].focus();
        } else if (targetTab === 'tab-area' && areaInputs[unit]) {
          areaInputs[unit].value = val;
          updateAreaFrom(unit, val);
          areaInputs[unit].focus();
        }
      });
    });

    // ------------------------------------------------------------------------
    // TAB 4: CARTON CBM CALCULATOR
    // ------------------------------------------------------------------------
    const cbmLen = document.getElementById('cbm-len');
    const cbmWid = document.getElementById('cbm-wid');
    const cbmHgt = document.getElementById('cbm-hgt');
    const cbmQty = document.getElementById('cbm-qty');

    const resCbm = document.getElementById('cbm-result-cbm');
    const resAir = document.getElementById('cbm-result-air');
    const resFba = document.getElementById('cbm-result-fba');

    function calculateCbm() {
      if (!cbmLen || !cbmWid || !cbmHgt || !cbmQty) return;
      const l = parseFloat(cbmLen.value) || 0;
      const w = parseFloat(cbmWid.value) || 0;
      const h = parseFloat(cbmHgt.value) || 0;
      const qty = parseInt(cbmQty.value, 10) || 1;

      // 1 carton CBM = (l * w * h) / 1,000,000
      const singleCbm = (l * w * h) / 1000000;
      const totalCbm = singleCbm * qty;

      // Air Express Dim Wt in KG = (l * w * h) / 5000 * qty
      const airDimKg = ((l * w * h) / 5000) * qty;

      // Amazon FBA US Volumetric Wt in LBS = (L_in * W_in * H_in) / 139 * qty
      const lIn = l / 2.54;
      const wIn = w / 2.54;
      const hIn = h / 2.54;
      const fbaDimLbs = ((lIn * wIn * hIn) / 139) * qty;

      if (resCbm) resCbm.textContent = `${totalCbm.toFixed(3)} m³`;
      if (resAir) resAir.textContent = `${airDimKg.toFixed(1)} kg`;
      if (resFba) resFba.textContent = `${fbaDimLbs.toFixed(1)} lbs`;
    }

    [cbmLen, cbmWid, cbmHgt, cbmQty].forEach(input => {
      if (input) input.addEventListener('input', calculateCbm);
    });

    // Initial calculations on load
    updateLengthFrom('in', '25');
    updateTempFrom('c', '20');
    updateAreaFrom('sqft', '13.33');
    calculateCbm();
  })();
</script>
