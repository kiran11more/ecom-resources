---
import '../styles/global.css';
import MobileDrawer from '../components/navigation/MobileDrawer.astro';
import ListResourceModal from '../components/modals/ListResourceModal.astro';
import NewsModal from '../components/modals/NewsModal.astro';
import LoginModal from '../components/modals/LoginModal.astro';
import { DIRECTORY_RESOURCES } from '../data/resources';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Global Cross-Border E-Commerce Resources Directory — Seller tools, wholesale sourcing, logistics, PPC marketing, and calculators.',
  canonical = Astro.url.href,
} = Astro.props;

// Lightweight search index for instant zero-latency client-side search across all 59+ tools
const searchIndex = DIRECTORY_RESOURCES.map((r) => ({
  name: r.name,
  slug: r.slug || r.id,
  category: r.category,
  categorySlug: r.categorySlug,
  description: r.description,
  pricing: r.pricing || 'Free',
  url: r.url,
  internalUrl: r.internalUrl || (r.hasDetailPage ? `/resources/${r.slug || r.id}` : null),
  hasDetailPage: Boolean(r.hasDetailPage),
  isVerified: r.isVerified !== undefined ? Boolean(r.isVerified) : true,
  badge: r.badge || null,
  tags: Array.isArray(r.tags) ? r.tags : [],
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono (Non-blocking async stylesheet) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      />
    </noscript>

    <!-- Prevent Flash of Unstyled Content (FOUC) on page load -->
    <script is:inline>
      (function () {
        const pref = localStorage.getItem('theme-preference') || 'system';
        const isDark =
          pref === 'dark' ||
          (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-dark-bg dark:text-slate-100 font-sans w-full overflow-x-clip">
    <slot />
    <MobileDrawer />
    <ListResourceModal />
    <NewsModal />
    <LoginModal />
    <script type="application/json" id="directory-search-index" set:html={JSON.stringify(searchIndex)} />

    <!-- Global Workspace Auth State Synchronization Script -->
    <script is:inline>
      (function () {
        function syncAuthState() {
          const isLoggedIn = sessionStorage.getItem('ecom_logged_in') === 'true';
          const userName = sessionStorage.getItem('ecom_user_name') || 'Demo Seller';

          // Header Elements
          const headerLoginBtn = document.getElementById('header-login-btn');
          const headerWsDropdown = document.getElementById('header-workspace-dropdown');
          const headerUserDisplay = document.getElementById('header-user-display');
          const headerWsLabel = document.getElementById('header-workspace-label');

          if (headerLoginBtn && headerWsDropdown) {
            if (isLoggedIn) {
              headerLoginBtn.classList.add('hidden');
              headerWsDropdown.classList.remove('hidden');
              if (headerUserDisplay) headerUserDisplay.textContent = userName;
              if (headerWsLabel) headerWsLabel.textContent = `${userName.split(' ')[0]} ▾`;
            } else {
              headerLoginBtn.classList.remove('hidden');
              headerWsDropdown.classList.add('hidden');
            }
          }

          // Mobile Drawer Elements
          const mobileLoginBtn = document.getElementById('mobile-drawer-login-btn');
          const mobileWsPanel = document.getElementById('mobile-drawer-workspace-panel');
          const mobileWsUser = document.getElementById('mobile-workspace-user');

          if (mobileLoginBtn && mobileWsPanel) {
            if (isLoggedIn) {
              mobileLoginBtn.classList.add('hidden');
              mobileWsPanel.classList.remove('hidden');
              if (mobileWsUser) mobileWsUser.textContent = userName;
            } else {
              mobileLoginBtn.classList.remove('hidden');
              mobileWsPanel.classList.add('hidden');
            }
          }
        }

        // Attach global sign-out listeners
        document.addEventListener('click', (e) => {
          const target = e.target instanceof Element ? e.target : e.target?.parentElement;
          if (!target) return;

          if (target.closest('#header-signout-btn') || target.closest('#mobile-drawer-signout-btn')) {
            e.preventDefault();
            sessionStorage.removeItem('ecom_logged_in');
            sessionStorage.removeItem('ecom_user_name');
            syncAuthState();
          }
        });

        window.addEventListener('ecom-auth-change', syncAuthState);
        document.addEventListener('DOMContentLoaded', syncAuthState);
        syncAuthState();
      })();
    </script>
  </body>
</html>
