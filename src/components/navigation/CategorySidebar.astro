---
// Category / Section Navigation Rail mapped from approved sitemap
const RAIL_SECTIONS = [
  { id: 'wholesale-marketplaces', name: 'Wholesale & Stores', count: 10 },
  { id: 'everyday-tools', name: 'Everyday Tools', count: 8 },
  { id: 'browser-extensions', name: 'Extensions & Deals', count: 22 },
  { id: 'currency-rates', name: 'Currency Rates', count: 9 },
  { id: 'product-research', name: 'Product Research', count: 6 },
  { id: 'cross-border-information', name: 'Cross-Border Info', count: 3 },
  { id: 'email-marketing', name: 'Email Marketing', count: 7 },
  { id: 'advertising-platforms', name: 'Advertising PPC', count: 4 },
  { id: 'store-opening', name: 'Store Opening', count: 5 },
  { id: 'sourcing', name: 'Sourcing Hubs', count: 6 },
  { id: 'warehouse-logistics', name: 'Logistics & 3PL', count: 5 },
  { id: 'videos-social', name: 'Videos & UGC', count: 6 },
  { id: 'legal-services', name: 'Legal & IP', count: 4 },
  { id: 'trademarks-patents', name: 'Trademarks & Patents', count: 18 },
  { id: 'accounting', name: 'Accounting & VAT', count: 4 },
  { id: 'popular-shop-locations', name: 'Regional Hubs', count: 10 },
];
---

<aside class="hidden lg:block w-64 shrink-0 sticky top-24 self-start max-h-[calc(100vh-6.5rem)] overflow-y-auto no-scrollbar relative select-none space-y-3">
  <!-- Modern Floating Sticky Rail Card -->
  <div class="bg-white/95 dark:bg-[#131924]/95 backdrop-blur-md border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-2 sm:p-2.5 shadow-sm flex flex-col justify-between transition-all duration-150">
    <!-- Header -->
    <div class="flex items-center justify-between px-2.5 py-2 mb-1 border-b border-slate-100 dark:border-white/[0.05]">
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-800 dark:text-slate-100">
          QUICK RAIL
        </span>
      </div>
      <span id="rail-active-badge" class="text-[10px] font-mono font-bold text-brand-orange bg-brand-orange/10 px-1.5 py-0.2 rounded">
        AUTO
      </span>
    </div>

    <!-- Vertical Anchor Links (Scrollspy Controlled) -->
    <nav aria-label="Directory Section Quick Jump" class="space-y-0.5 py-1">
      {
        RAIL_SECTIONS.map((sec, idx) => (
          <a
            href={`/#${sec.id}`}
            data-rail-id={sec.id}
            class={`rail-item flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs transition-all font-medium ${idx === 0 ? 'rail-active' : ''}`}
          >
            <div class="flex items-center gap-1.5 truncate">
              <span class="rail-dash text-slate-400 transition-colors">
                -
              </span>
              <span class="truncate font-semibold">{sec.name}</span>
            </div>

            {sec.count && (
              <span class="rail-count text-[10px] font-semibold opacity-75 px-1 py-0.2 rounded shrink-0">
                {sec.count}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <!-- Bottom Actions: Back to Top & Quick Home -->
    <div class="mt-2 pt-2 border-t border-slate-100 dark:border-white/[0.05] flex items-center gap-1">
      <button
        type="button"
        id="rail-scroll-top"
        title="Scroll to Top of Page"
        class="flex-1 flex items-center justify-center gap-1 py-1.5 px-2 rounded-lg text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:text-brand-orange hover:bg-slate-100 dark:hover:bg-white/[0.05] transition-colors cursor-pointer"
      >
        <span>Top</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>

      <a
        href="/#everyday-tools"
        title="Jump to Everyday Tools"
        class="flex-1 flex items-center justify-center gap-1 py-1.5 px-2 rounded-lg text-[11px] font-bold text-brand-orange bg-brand-orange/10 hover:bg-brand-orange/20 transition-colors"
      >
        <span>Tools</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Featured Partner / Sponsor Promo Card -->
  <div class="bg-gradient-to-br from-brand-orange/10 via-slate-50 to-amber-500/10 dark:from-brand-orange/15 dark:via-dark-card dark:to-brand-orange/5 border border-brand-orange/25 dark:border-brand-orange/30 rounded-2xl p-3 shadow-xs relative overflow-hidden group">
    <div class="flex items-center justify-between mb-2">
      <span class="text-[9px] font-extrabold uppercase tracking-widest text-brand-orange bg-brand-orange/15 px-1.5 py-0.5 rounded">
        Featured Partner
      </span>
      <span class="text-[10px] text-slate-400 font-mono">Sponsor</span>
    </div>
    
    <div class="flex items-center gap-2 mb-2">
      <div class="w-8 h-8 rounded-xl bg-white dark:bg-white/10 p-1 flex items-center justify-center shrink-0 shadow-2xs">
        <img
          src="https://www.google.com/s2/favicons?domain=helium10.com&sz=64"
          alt="Helium 10"
          class="w-5 h-5 object-contain rounded"
          loading="lazy"
        />
      </div>
      <div class="min-w-0 flex-1">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">Helium 10</h4>
        <p class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 truncate">Amazon Seller Suite</p>
      </div>
    </div>
    
    <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-snug mb-2.5">
      Instant FBA product research, keyword rank tracking & profit calculations.
    </p>

    <a
      href="https://www.helium10.com"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-1.5 px-2.5 rounded-lg bg-brand-orange hover:bg-brand-orangeHover text-white text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-2xs transition-all group-hover:scale-102"
    >
      <span>Explore Suite</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</aside>

<style>
  /* Standard Inactive Link */
  .rail-item {
    color: #475569;
    background-color: transparent;
  }
  :global(.dark) .rail-item {
    color: #94a3b8;
  }
  /* Inactive Link Hover: Subtle warm background with brand-orange text */
  .rail-item:hover:not(.rail-active) {
    color: #F25A2B;
    background-color: rgba(241, 245, 249, 0.8);
  }
  :global(.dark) .rail-item:hover:not(.rail-active) {
    color: #F25A2B;
    background-color: rgba(255, 255, 255, 0.05);
  }
  .rail-item:hover:not(.rail-active) .rail-dash {
    color: #F25A2B;
  }

  /* ACTIVE STATE: Bulletproof white text on brand-orange, even when HOVERED or FOCUSED! */
  .rail-item.rail-active,
  .rail-item.rail-active:hover,
  .rail-item.rail-active:focus,
  .rail-item.rail-active:active {
    background-color: #F25A2B !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    box-shadow: 0 1px 3px rgba(242, 90, 43, 0.35) !important;
  }
  /* Force all child elements (name, dash, count) to stay 100% pure white on active */
  .rail-item.rail-active *,
  .rail-item.rail-active:hover *,
  .rail-item.rail-active:focus *,
  .rail-item.rail-active:active * {
    color: #ffffff !important;
    opacity: 1 !important;
  }
  .rail-item.rail-active:hover {
    background-color: #D94618 !important;
  }
</style>

<!-- High-Performance Client-Side Scrollspy Script -->
<script is:inline>
  (function () {
    const railItems = document.querySelectorAll('.rail-item');
    const scrollTopBtn = document.getElementById('rail-scroll-top');

    // 1. Back to Top Click
    if (scrollTopBtn) {
      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 2. Set Active Item Styling (Pure White on Orange)
    function setActiveItem(activeId) {
      railItems.forEach((item) => {
        const id = item.getAttribute('data-rail-id');
        const isActive = id === activeId;
        item.classList.toggle('rail-active', isActive);
      });
    }

    // 3. Click Handler on Rail Items (Native smooth scroll, zero forced reflow)
    railItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        const id = item.getAttribute('data-rail-id');
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
          setActiveItem(id);
        }
      });
    });

    // 4. Zero-Reflow Scrollspy via native IntersectionObserver
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -70% 0px',
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActiveItem(entry.target.id);
        }
      });
    }, observerOptions);

    railItems.forEach((item) => {
      const id = item.getAttribute('data-rail-id');
      if (id) {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      }
    });
  })();
</script>
