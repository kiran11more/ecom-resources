---
import { COUNTRY_MARKETPLACES } from '../../data/navigation';
---

<!-- AMZ123-Style Country Marketplace Quick Launchpad -->
<section aria-label="Country Marketplace Direct Launchpad" class="bg-white dark:bg-dark-card border border-slate-200/90 dark:border-white/[0.08] rounded-2xl p-4 sm:p-5 shadow-xs w-full min-w-0 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-100 dark:border-white/[0.06]">
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-brand-orange animate-pulse"></span>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Global Amazon Marketplaces & Direct BSR Access
          </h3>
          <span class="text-xs font-semibold text-brand-orange bg-brand-orange/10 dark:bg-brand-orange/20 px-2.5 py-0.5 rounded-full">
            10 Active Stations
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 hidden sm:block">
          One-click direct portal to hourly-updated Best Seller Lists (Top 100) & marketplace storefronts.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 text-xs shrink-0">
      <a
        href="https://trends.google.com/trends/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/30 hover:bg-blue-500/25 transition-colors"
        title="Explore live product demand on Google Trends"
      >
        <img src="https://www.google.com/s2/favicons?domain=trends.google.com&sz=64" alt="" class="w-3.5 h-3.5 object-contain" />
        <span>Google Trends ↗</span>
      </a>
      <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Hourly BSR Sync</span>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 w-full min-w-0">
    {
      COUNTRY_MARKETPLACES.map((country) => {
        const flagCode = country.flagCode || (country.code === 'UK' ? 'gb' : country.code.toLowerCase());
        return (
          <div class="p-3.5 rounded-xl bg-slate-50/80 dark:bg-[#131924]/80 border border-slate-200/80 dark:border-white/[0.06] hover:border-brand-orange/60 dark:hover:border-brand-orange/60 hover:bg-white dark:hover:bg-white/[0.03] hover:shadow-xs hover:-translate-y-0.5 transition-all flex flex-col justify-between group">
            <!-- Row 1: Flag icon + Marketplace Title on Left, 2-Letter Country Badge on Right -->
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-6 h-4 rounded-xs overflow-hidden shadow-2xs border border-black/10 dark:border-white/10 shrink-0">
                  <img
                    src={`https://flagcdn.com/w40/${flagCode}.png`}
                    srcset={`https://flagcdn.com/w80/${flagCode}.png 2x`}
                    alt={`${country.name} flag`}
                    class="w-full h-full object-cover select-none"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
                <h4 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-brand-orange transition-colors whitespace-nowrap">
                  {country.shortName || country.name}
                </h4>
              </div>

              <!-- Compact 2-Letter Country Badge -->
              <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 font-mono bg-slate-100 dark:bg-white/[0.06] border border-slate-200/60 dark:border-white/[0.06] px-1.5 py-0.5 rounded shrink-0">
                {country.code}
              </span>
            </div>

            <!-- Row 2: Domain on its own line directly below title -->
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono truncate mt-0.5 mb-3">
              {country.domain || country.url.replace('https://www.', '')}
            </div>

            <!-- Bottom Action Row: BSR (Primary) & Store (Secondary) -->
            <div class="grid grid-cols-2 gap-2 pt-2.5 border-t border-slate-200/60 dark:border-white/[0.04]">
              <a
                href={country.bsrUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-center font-bold text-xs text-brand-orange bg-brand-orange/10 hover:bg-brand-orange hover:text-white py-1.5 px-2 rounded-lg transition-all flex items-center justify-center gap-1 shadow-2xs"
                title={`Hourly updated Amazon ${country.code} Best Sellers (Top 100)`}
              >
                <span>BSR</span>
                <span class="text-[10px]">🔥</span>
              </a>
              <a
                href={country.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-center font-semibold text-xs text-slate-600 dark:text-slate-300 bg-white dark:bg-white/[0.06] hover:bg-slate-200 dark:hover:bg-white/15 border border-slate-200/60 dark:border-white/10 py-1.5 px-2 rounded-lg transition-all flex items-center justify-center gap-1 shadow-2xs"
                title={`Visit Amazon ${country.name} Marketplace Store`}
              >
                <span>Store</span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
