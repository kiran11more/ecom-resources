<!-- Client-side Interactive Tabs & Live Filtering Script -->
<script is:inline>
  (function () {
    // 1. Tab Switching Logic for Module 1
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');
        if (!targetId) return;

        tabButtons.forEach((b) => b.classList.remove('tab-btn-active'));
        btn.classList.add('tab-btn-active');

        tabPanels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.id !== targetId);
        });
      });
    });

    // 2. Real-Time Search Filtering
    const input = document.getElementById('resource-filter-input');
    const items = document.querySelectorAll('.resource-item');
    const sections = document.querySelectorAll('#directory-stream section');
    const noResults = document.getElementById('no-filter-results');
    const resetBtn = document.getElementById('reset-filter-btn');

    function filterBySearch(query) {
      const q = query.trim().toLowerCase();
      let totalVisible = 0;

      sections.forEach((section) => {
        const sectionItems = section.querySelectorAll('.resource-item');
        if (sectionItems.length === 0) return;

        let sectionVisible = 0;

        sectionItems.forEach((item) => {
          const name = item.getAttribute('data-name') || '';
          const desc = item.getAttribute('data-desc') || '';
          const matches = !q || name.includes(q) || desc.includes(q);

          item.style.display = matches ? '' : 'none';
          if (matches) sectionVisible++;
        });

        if (q && sectionVisible === 0) {
          section.style.display = 'none';
        } else {
          section.style.display = '';
        }

        totalVisible += sectionVisible;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', totalVisible > 0);
      }
    }

    if (input) {
      input.addEventListener('input', (e) => {
        filterBySearch(e.target.value || '');
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (input) input.value = '';
        filterBySearch('');
      });
    }

    // 3. Real-Time Currency FX Engine (Coinbase Spot + Open.er-api Fallback + 60s Polling)
    const fxInput = document.getElementById('fx-calc-input');

    // Baseline fallback rates
    let currentRates = {
      CNY: 6.6851,
      EUR: 0.903491,
      GBP: 0.755149,
      JPY: 159.80,
      CAD: 1.3850,
      AUD: 1.5280,
      INR: 84.42,
      SGD: 1.3480,
      AED: 3.6725,
    };

    function setFxStatus(status, timestamp) {
      const isLive = status === 'live';
      let badgeText = 'Offline Ref';
      if (isLive) {
        const d = timestamp ? new Date(timestamp) : new Date();
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');
        badgeText = `Live Spot • ${hours}:${minutes}`;
      }

      const bentoLabel = document.getElementById('bento-fx-label');
      const directoryLabel = document.getElementById('directory-fx-label');
      const bentoDot = document.getElementById('bento-fx-dot');
      const directoryDot = document.getElementById('directory-fx-dot');
      const bentoPill = document.getElementById('bento-fx-pill');
      const directoryPill = document.getElementById('directory-fx-pill');

      if (bentoLabel) bentoLabel.textContent = badgeText;
      if (directoryLabel) directoryLabel.textContent = badgeText;

      if (isLive) {
        if (bentoDot) bentoDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
        if (directoryDot) directoryDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';

        if (bentoPill) {
          bentoPill.className = 'text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full flex items-center gap-1 transition-colors';
        }
        if (directoryPill) {
          directoryPill.className = 'text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full flex items-center gap-1.5 w-fit transition-colors';
        }
      } else {
        if (bentoDot) bentoDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
        if (directoryDot) directoryDot.className = 'w-2 h-2 rounded-full bg-amber-500';

        if (bentoPill) {
          bentoPill.className = 'text-[10px] font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-full flex items-center gap-1 transition-colors';
        }
        if (directoryPill) {
          directoryPill.className = 'text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-3 py-1 rounded-full flex items-center gap-1.5 w-fit transition-colors';
        }
      }
    }

    function updateFxConversion() {
      const inputEl = document.getElementById('fx-calc-input');
      if (!inputEl) return;
      const amount = parseFloat(inputEl.value) || 0;

      const outputs = {
        'fx-val-cny': (amount * (currentRates.CNY || 6.6851)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-eur': (amount * (currentRates.EUR || 0.9035)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-gbp': (amount * (currentRates.GBP || 0.7551)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-jpy': Math.round(amount * (currentRates.JPY || 159.80)).toLocaleString('en-US'),
        'fx-val-cad': (amount * (currentRates.CAD || 1.3850)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-aud': (amount * (currentRates.AUD || 1.5280)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-inr': (amount * (currentRates.INR || 84.42)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-sgd': (amount * (currentRates.SGD || 1.3480)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        'fx-val-aed': (amount * (currentRates.AED || 3.6725)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
      };

      Object.entries(outputs).forEach(([id, formatted]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatted;
      });
    }

    function applyLiveRates(rates, timestamp) {
      if (!rates || typeof rates !== 'object') return false;

      // Merge into current rates
      Object.keys(currentRates).forEach((cur) => {
        if (typeof rates[cur] === 'number' && rates[cur] > 0) {
          currentRates[cur] = rates[cur];
        }
      });

      // Target mapping matching exact user requirements:
      // USD / CNY -> CNY.toFixed(4)
      // EUR / USD -> (1 / EUR).toFixed(4)
      // GBP / USD -> (1 / GBP).toFixed(4)
      // USD / JPY -> JPY.toFixed(2)
      const pairMap = {
        'USD/CNY': currentRates.CNY ? currentRates.CNY.toFixed(4) : null,
        'EUR/USD': currentRates.EUR ? (1 / currentRates.EUR).toFixed(4) : null,
        'GBP/USD': currentRates.GBP ? (1 / currentRates.GBP).toFixed(4) : null,
        'USD/JPY': currentRates.JPY ? currentRates.JPY.toFixed(2) : null,
        'USD/CAD': currentRates.CAD ? currentRates.CAD.toFixed(4) : null,
        'USD/AUD': currentRates.AUD ? currentRates.AUD.toFixed(4) : null,
        'USD/INR': currentRates.INR ? currentRates.INR.toFixed(2) : null,
        'USD/SGD': currentRates.SGD ? currentRates.SGD.toFixed(4) : null,
        'USD/AED': currentRates.AED ? currentRates.AED.toFixed(4) : null,
      };

      // Update every [data-fx-pair] element across BentoDashboard and DirectorySection
      document.querySelectorAll('[data-fx-pair]').forEach((el) => {
        const rawPair = el.getAttribute('data-fx-pair') || '';
        const normalized = rawPair.replace(/\s+/g, '').toUpperCase();

        if (pairMap[normalized]) {
          el.textContent = pairMap[normalized];
        } else {
          // Generic handler for other currency pairs
          const parts = normalized.split('/');
          if (parts.length === 2) {
            const [base, quote] = parts;
            if (base === 'USD' && currentRates[quote]) {
              el.textContent = currentRates[quote] >= 50 ? currentRates[quote].toFixed(2) : currentRates[quote].toFixed(4);
            } else if (quote === 'USD' && currentRates[base]) {
              el.textContent = (1 / currentRates[base]).toFixed(4);
            }
          }
        }
      });

      // Recalculate quick converter output values
      updateFxConversion();

      // Only mark Live if real rates were successfully written
      setFxStatus('live', timestamp || Date.now());
      return true;
    }

    const CACHE_KEY = 'ecom_fx_spot_v2';
    const CACHE_TTL_MS = 60 * 1000; // 60 seconds TTL

    async function fetchFromCoinbase() {
      const res = await fetch('https://api.coinbase.com/v2/exchange-rates?currency=USD');
      if (!res.ok) throw new Error('Coinbase HTTP ' + res.status);
      const data = await res.json();
      const raw = (data && data.data && data.data.rates) || (data && data.rates);
      if (!raw || typeof raw !== 'object') throw new Error('Invalid Coinbase payload');

      const parsed = {};
      ['CNY', 'EUR', 'GBP', 'JPY', 'CAD', 'AUD', 'INR', 'SGD', 'AED'].forEach((k) => {
        if (raw[k] !== undefined) {
          const val = typeof raw[k] === 'number' ? raw[k] : parseFloat(raw[k]);
          if (!isNaN(val) && val > 0) {
            parsed[k] = val;
          }
        }
      });

      if (!parsed.CNY || !parsed.EUR) throw new Error('Incomplete Coinbase rates');
      return parsed;
    }

    async function fetchFromOpenErApi() {
      const res = await fetch('https://open.er-api.com/v6/latest/USD');
      if (!res.ok) throw new Error('Open.er-api HTTP ' + res.status);
      const data = await res.json();
      if (!data || data.result !== 'success' || !data.rates) throw new Error('Invalid Open.er-api payload');

      const parsed = {};
      ['CNY', 'EUR', 'GBP', 'JPY', 'CAD', 'AUD', 'INR', 'SGD', 'AED'].forEach((k) => {
        if (data.rates[k] !== undefined) {
          const val = typeof data.rates[k] === 'number' ? data.rates[k] : parseFloat(data.rates[k]);
          if (!isNaN(val) && val > 0) {
            parsed[k] = val;
          }
        }
      });

      if (!parsed.CNY || !parsed.EUR) throw new Error('Incomplete Open.er-api rates');
      return parsed;
    }

    async function fetchLiveExchangeRates() {
      let fetchedRates = null;
      let timestamp = Date.now();

      // 1. Primary endpoint: api.coinbase.com (true intraday real-time spot rates)
      try {
        fetchedRates = await fetchFromCoinbase();
        timestamp = Date.now();
      } catch (cbErr) {
        console.warn('Primary Coinbase FX API failed, trying open.er-api fallback...', cbErr);
        // 2. Fallback endpoint: open.er-api.com
        try {
          fetchedRates = await fetchFromOpenErApi();
          timestamp = Date.now();
        } catch (fbErr) {
          console.warn('Fallback FX API (open.er-api) failed.', fbErr);
        }
      }

      if (fetchedRates) {
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp, rates: fetchedRates }));
        } catch (_) {}
        applyLiveRates(fetchedRates, timestamp);
        return true;
      }

      // Check if we have recent cached rates
      try {
        const cachedRaw = localStorage.getItem(CACHE_KEY);
        if (cachedRaw) {
          const cached = JSON.parse(cachedRaw);
          if (cached && cached.rates && cached.timestamp) {
            applyLiveRates(cached.rates, cached.timestamp);
            return true;
          }
        }
      } catch (_) {}

      setFxStatus('offline');
      return false;
    }

    // Clear legacy caches
    try {
      localStorage.removeItem('ecom_fx_rates_v1');
      sessionStorage.removeItem('ecom_live_fx_v1');
      sessionStorage.removeItem('ecom_live_fx_time');
    } catch (_) {}

    // 1. Instant Cache Hydration (<60s TTL)
    try {
      const cachedRaw = localStorage.getItem(CACHE_KEY);
      if (cachedRaw) {
        const cached = JSON.parse(cachedRaw);
        if (cached && cached.rates && (Date.now() - cached.timestamp < CACHE_TTL_MS)) {
          applyLiveRates(cached.rates, cached.timestamp);
        }
      }
    } catch (_) {}

    // 2. Fetch fresh rates immediately
    fetchLiveExchangeRates();

    // 3. 60-Second Polling while tab is visible
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        fetchLiveExchangeRates();
      }
    }, 60000);

    // 4. Tab Visibility Change Listener
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        try {
          const cachedRaw = localStorage.getItem(CACHE_KEY);
          if (cachedRaw) {
            const cached = JSON.parse(cachedRaw);
            if (cached && cached.rates && (Date.now() - cached.timestamp < CACHE_TTL_MS)) {
              return; // Cache still fresh
            }
          }
        } catch (_) {}
        fetchLiveExchangeRates();
      }
    });

    if (fxInput) {
      fxInput.addEventListener('input', updateFxConversion);
    }
  })();
</script>
