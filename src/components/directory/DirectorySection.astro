<style>
  /* Inactive Tab Button */
  .tab-btn {
    color: #475569;
    background-color: transparent;
  }
  :global(.dark) .tab-btn {
    color: #94a3b8;
  }
  .tab-btn:hover:not(.tab-btn-active) {
    color: #F25A2B;
    background-color: rgba(241, 245, 249, 0.9);
  }
  :global(.dark) .tab-btn:hover:not(.tab-btn-active) {
    color: #F25A2B;
    background-color: rgba(255, 255, 255, 0.06);
  }

  /* Active Tab Button: Solid Brand Orange with Pure Crisp White Text ALWAYS */
  .tab-btn.tab-btn-active,
  .tab-btn.tab-btn-active:hover,
  .tab-btn.tab-btn-active:focus,
  .tab-btn.tab-btn-active:active {
    background-color: #F25A2B !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    box-shadow: 0 1px 3px rgba(242, 90, 43, 0.35) !important;
  }
  .tab-btn.tab-btn-active:hover {
    background-color: #D94618 !important; /* Rich darker orange on active hover, text STILL pure white! */
  }
</style>

<!-- Client-side Interactive Tabs & Live Filtering Script -->
<script is:inline>
  (function () {
    // 1. Tab Switching Logic for Module 1
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');
        if (!targetId) return;

        tabButtons.forEach((b) => b.classList.remove('tab-btn-active'));
        btn.classList.add('tab-btn-active');

        tabPanels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.id !== targetId);
        });
      });
    });

    // 2. Real-Time Search Filtering
    const input = document.getElementById('resource-filter-input');
    const items = document.querySelectorAll('.resource-item');
    const sections = document.querySelectorAll('#directory-stream section');
    const noResults = document.getElementById('no-filter-results');
    const resetBtn = document.getElementById('reset-filter-btn');

    function filterBySearch(query) {
      const q = query.trim().toLowerCase();
      let totalVisible = 0;

      sections.forEach((section) => {
        const sectionItems = section.querySelectorAll('.resource-item');
        if (sectionItems.length === 0) return;

        let sectionVisible = 0;

        sectionItems.forEach((item) => {
          const name = item.getAttribute('data-name') || '';
          const desc = item.getAttribute('data-desc') || '';
          const matches = !q || name.includes(q) || desc.includes(q);

          item.style.display = matches ? '' : 'none';
          if (matches) sectionVisible++;
        });

        if (q && sectionVisible === 0) {
          section.style.display = 'none';
        } else {
          section.style.display = '';
        }

        totalVisible += sectionVisible;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', totalVisible > 0);
      }
    }

    if (input) {
      input.addEventListener('input', (e) => {
        filterBySearch(e.target.value || '');
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (input) input.value = '';
        filterBySearch('');
      });
    }

    // 3. Real-Time Currency FX Engine (Live Interbank Feed + Converter)
    const fxInput = document.getElementById('fx-calc-input');
    const cnyOutput = document.getElementById('fx-val-cny');
    const eurOutput = document.getElementById('fx-val-eur');
    const gbpOutput = document.getElementById('fx-val-gbp');
    const jpyOutput = document.getElementById('fx-val-jpy');
    const bentoFxLabel = document.getElementById('bento-fx-label');
    const directoryFxLabel = document.getElementById('directory-fx-label');

    // Baseline fallback rates
    const liveFx = {
      cny: 7.2418,
      eur: 0.92385, // USD to EUR
      gbp: 0.7725,  // USD to GBP
      jpy: 154.62,
      cad: 1.3850,
      aud: 1.5280,
    };

    function updateFxConversion() {
      if (!fxInput) return;
      const amount = parseFloat(fxInput.value) || 0;
      if (cnyOutput) cnyOutput.textContent = (amount * liveFx.cny).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (eurOutput) eurOutput.textContent = (amount * liveFx.eur).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (gbpOutput) gbpOutput.textContent = (amount * liveFx.gbp).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (jpyOutput) jpyOutput.textContent = Math.round(amount * liveFx.jpy).toLocaleString('en-US');
    }

    function applyLiveRates(rates) {
      if (!rates) return;
      if (rates.CNY) liveFx.cny = rates.CNY;
      if (rates.EUR) liveFx.eur = rates.EUR;
      if (rates.GBP) liveFx.gbp = rates.GBP;
      if (rates.JPY) liveFx.jpy = rates.JPY;
      if (rates.CAD) liveFx.cad = rates.CAD;
      if (rates.AUD) liveFx.aud = rates.AUD;

      // Update all rate display cards on page (both Bento box and Directory section)
      const pairMaps = {
        'USD / CNY': liveFx.cny.toFixed(4),
        'EUR / USD': (1 / liveFx.eur).toFixed(4),
        'GBP / USD': (1 / liveFx.gbp).toFixed(4),
        'USD / JPY': liveFx.jpy.toFixed(2),
        'USD / CAD': liveFx.cad.toFixed(4),
        'USD / AUD': liveFx.aud.toFixed(4),
      };

      Object.entries(pairMaps).forEach(([pair, val]) => {
        document.querySelectorAll(`[data-fx-pair="${pair}"]`).forEach((el) => {
          el.textContent = val;
        });
      });

      // Recalculate converter values
      updateFxConversion();

      // Update live status badges with time
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (bentoFxLabel) bentoFxLabel.textContent = `Live (${timeStr})`;
      if (directoryFxLabel) directoryFxLabel.textContent = `Live Market Feed (${timeStr})`;
    }

    async function fetchLiveExchangeRates() {
      const CACHE_KEY = 'ecom_live_fx_v1';
      const CACHE_TIME_KEY = 'ecom_live_fx_time';
      const now = Date.now();
      const cached = sessionStorage.getItem(CACHE_KEY);
      const cachedTime = sessionStorage.getItem(CACHE_TIME_KEY);

      // Use 15-minute cache if available
      if (cached && cachedTime && (now - parseInt(cachedTime, 10) < 15 * 60 * 1000)) {
        try {
          applyLiveRates(JSON.parse(cached));
          return;
        } catch (_) {}
      }

      try {
        // Primary API: open.er-api.com (No API key, free, fast, CORS enabled)
        const res = await fetch('https://open.er-api.com/v6/latest/USD');
        if (res.ok) {
          const data = await res.json();
          if (data && data.rates) {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify(data.rates));
            sessionStorage.setItem(CACHE_TIME_KEY, now.toString());
            applyLiveRates(data.rates);
            return;
          }
        }
      } catch (err) {
        console.warn('Primary FX API error, attempting fallback...', err);
      }

      try {
        // Fallback API: European Central Bank via frankfurter.dev
        const resFallback = await fetch('https://api.frankfurter.dev/v1/latest?base=USD');
        if (resFallback.ok) {
          const dataFallback = await resFallback.json();
          if (dataFallback && dataFallback.rates) {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify(dataFallback.rates));
            sessionStorage.setItem(CACHE_TIME_KEY, now.toString());
            applyLiveRates(dataFallback.rates);
          }
        }
      } catch (err2) {
        console.warn('Fallback FX API unreachable, staying on baseline rates.', err2);
      }
    }

    if (fxInput) {
      fxInput.addEventListener('input', updateFxConversion);
    }

    // Initialize real-time rates
    fetchLiveExchangeRates();
  })();
</script>
