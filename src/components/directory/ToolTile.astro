---
import type { DirectoryResource } from '../../data/navigation';

interface Props {
  resource: DirectoryResource;
}

const { resource } = Astro.props;

// 1. Direct Official Domain Mapping for High-Resolution Real Brand Favicons
const DOMAIN_OVERRIDES: Record<string, string> = {
  // Email Marketing (Real unique corporate logos!)
  'mailchimp': 'mailchimp.com',
  'sendinblue': 'brevo.com',
  'lemlist': 'lemlist.com',
  'activecampaign': 'activecampaign.com',
  'drip': 'drip.com',
  'constant-contact': 'constantcontact.com',
  'aweber': 'aweber.com',

  // Advertising Platforms
  'google-ads': 'google.com',
  'amazon-ads': 'amazon.com',
  'meta-ads': 'meta.com',
  'microsoft-ads': 'microsoft.com',

  // Product Research & AI
  'google-trends': 'trends.google.com',
  'chatgpt-prompts': 'openai.com',
  'fba-calc': 'amazon.com',
  'amazon-bsr-us': 'amazon.com',
  'amazon-bsr-uk': 'amazon.co.uk',
  'amazon-bsr-de': 'amazon.de',
  'amazon-bsr-jp': 'amazon.co.jp',
  'amazon-bsr-ca': 'amazon.ca',

  // Marketplaces & Sourcing
  'store-amazon': 'amazon.com',
  'store-ebay': 'ebay.com',
  'store-tiktok': 'tiktok.com',
  'store-walmart': 'walmart.com',
  'store-shopify': 'shopify.com',
  'sourcing-1688': '1688.com',
  'sourcing-alibaba': 'alibaba.com',
  'sourcing-saleyee': 'saleyee.com',
  'sourcing-yiwugo': 'yiwugo.com',
  'sourcing-madeinchina': 'made-in-china.com',
  'sourcing-globalsources': 'globalsources.com',

  // Social & Creators
  'social-modash': 'modash.io',
  'social-billo': 'billo.app',
  'social-instagram': 'instagram.com',
  'social-tiktok': 'tiktok.com',
  'social-twitter': 'x.com',
  'social-youtube': 'youtube.com',

  // Logistics & Warehousing
  'logistics-fba': 'amazon.com',
  'logistics-flexport': 'flexport.com',
  'logistics-freightos': 'freightos.com',
  'logistics-shipbob': 'shipbob.com',
  'logistics-yunexpress': 'yunexpress.com',

  // Legal & IP
  'legal-uspto': 'uspto.gov',
  'legal-brand-registry': 'brandservices.amazon.com',
  'legal-euipo': 'euipo.europa.eu',
  'legal-legalzoom': 'legalzoom.com',

  // Accounting & Tax
  'accounting-quickbooks': 'quickbooks.intuit.com',
  'accounting-xero': 'xero.com',
  'accounting-taxjar': 'taxjar.com',
  'accounting-avalara': 'avalara.com',
};

// 2. Country Marketplace Flag Map (For Amazon BSR tools)
const COUNTRY_FLAGS: Record<string, { flag: string; label: string }> = {
  'amazon-bsr-us': { flag: '🇺🇸', label: 'USA' },
  'amazon-bsr-uk': { flag: '🇬🇧', label: 'UK' },
  'amazon-bsr-de': { flag: '🇩🇪', label: 'DE' },
  'amazon-bsr-jp': { flag: '🇯🇵', label: 'JP' },
  'amazon-bsr-ca': { flag: '🇨🇦', label: 'CA' },
};

const countryInfo = COUNTRY_FLAGS[resource.id];

// Determine domain for favicon
let domain = DOMAIN_OVERRIDES[resource.id] || '';
if (!domain && resource.url && resource.url.startsWith('http')) {
  try {
    domain = new URL(resource.url).hostname.replace(/^www\./, '');
  } catch {}
}

const isUtilityTool = [
  'length-converter',
  'temp-converter',
  'area-converter',
  'time-conversion',
  'ip-checker',
  'country-codes',
  'global-timezone',
  'world-port-codes',
].includes(resource.id);

// Determine routing mode
const slug = resource.slug || resource.id;
const isInternal = Boolean(resource.internalUrl);
const hasDetail = resource.hasDetailPage === true;

const Tag = hasDetail ? 'div' : 'a';
const outerHref = !hasDetail ? (isInternal ? resource.internalUrl : resource.url) : undefined;
const outerTarget = !hasDetail && !isInternal ? '_blank' : undefined;
const outerRel = !hasDetail && !isInternal ? 'noopener noreferrer' : undefined;

// High-resolution 128px official favicon from Google CDN
const faviconUrl = domain && !isUtilityTool
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128`
  : null;
---

<Tag
  href={outerHref}
  target={outerTarget}
  rel={outerRel}
  class="h-full w-full bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] hover:border-brand-orange/60 dark:hover:border-brand-orange/60 rounded-2xl p-4 sm:p-4.5 shadow-xs hover:shadow-md hover:bg-slate-50/40 dark:hover:bg-white/[0.02] transition-all flex flex-col justify-between group min-w-0 text-left relative"
  title={`${resource.name} — ${resource.description}`}
>
  {hasDetail && (
    <a
      href={`/resources/${slug}`}
      class="absolute inset-0 z-0 rounded-2xl"
      aria-label={`View details for ${resource.name}`}
    />
  )}

  <div class={`flex flex-col flex-1 ${hasDetail ? 'relative z-10 pointer-events-none' : ''}`}>
    <!-- Row 1 (Top bar): Place the tool logo on the left and highlight pill badge on top-right -->
    <div class="flex items-center justify-between gap-2 mb-3 min-w-0">
      <!-- 44px-48px Real Brand / Custom Tool Icon Container (Border-free) -->
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-slate-50/80 dark:bg-white/[0.04] p-1.5 sm:p-2 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform relative">
        {faviconUrl ? (
          <>
            {/* Real Official Corporate Brand Icon */}
            <img
              src={faviconUrl}
              alt={`${resource.name} logo`}
              class="w-8 h-8 sm:w-8.5 sm:h-8.5 object-contain rounded-md"
              loading="lazy"
              onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
            />

            {/* Country Flag Overlay Badge for Amazon Marketplaces */}
            {countryInfo && (
              <span class="absolute -bottom-1 -right-1 text-xs leading-none drop-shadow-sm select-none" title={countryInfo.label}>
                {countryInfo.flag}
              </span>
            )}

            {/* Fallback Initial Badge if Favicon network drops */}
            <div class="hidden w-full h-full items-center justify-center text-slate-800 dark:text-white font-extrabold text-sm">
              {resource.name.charAt(0)}
            </div>
          </>
        ) : (
          <>
            {/* Bespoke High-Detail Vector SVGs for Pure Utilities */}
            {resource.id === 'temp-converter' && (
              <div class="w-full h-full bg-gradient-to-br from-rose-500 to-amber-500 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
                </svg>
              </div>
            )}

            {resource.id === 'length-converter' && (
              <div class="w-full h-full bg-gradient-to-br from-cyan-500 to-blue-600 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4z" />
                  <path d="m14.5 5.5-2.5 2.5m-1-1-2.5 2.5m-1-1-2.5 2.5m-1-1-2.5 2.5" />
                </svg>
              </div>
            )}

            {resource.id === 'area-converter' && (
              <div class="w-full h-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              </div>
            )}

            {resource.id === 'time-conversion' && (
              <div class="w-full h-full bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </div>
            )}

            {resource.id === 'ip-checker' && (
              <div class="w-full h-full bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </div>
            )}

            {resource.id === 'country-codes' && (
              <div class="w-full h-full bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              </div>
            )}

            {resource.id === 'global-timezone' && (
              <div class="w-full h-full bg-gradient-to-br from-indigo-600 to-violet-700 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </div>
            )}

            {resource.id === 'world-port-codes' && (
              <div class="w-full h-full bg-gradient-to-br from-blue-700 to-cyan-700 text-white flex items-center justify-center rounded-lg p-1.5">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5" r="3" />
                  <line x1="12" y1="22" x2="12" y2="8" />
                  <path d="M5 12H2a10 10 0 0 0 20 0h-3" />
                </svg>
              </div>
            )}

            {!['temp-converter', 'length-converter', 'area-converter', 'time-conversion', 'ip-checker', 'country-codes', 'global-timezone', 'world-port-codes'].includes(resource.id) && (
              <div class="w-full h-full bg-gradient-to-br from-slate-700 to-slate-900 text-white font-bold text-sm flex items-center justify-center">
                {resource.name.charAt(0)}
              </div>
            )}
          </>
        )}
      </div>

      <!-- Highlight Pill Badge (Top-Right) -->
      {resource.badge && (
        <span class={`px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide border shrink-0 ${resource.badgeColor || 'bg-brand-orange/15 text-brand-orange border-brand-orange/30'}`}>
          {resource.badge}
        </span>
      )}
    </div>

    <!-- Row 2 (Title & Category): Full-width Tool/Platform Title + Checkmark + Category -->
    <div class="mb-2 min-w-0">
      <div class="flex items-center gap-1.5 min-w-0">
        <h4 class="text-base font-bold text-slate-900 dark:text-white leading-snug line-clamp-1 min-w-0 group-hover:text-brand-orange transition-colors">
          {resource.name}
        </h4>
        {resource.isVerified && (
          <span class="text-emerald-500 shrink-0" title="Verified Resource">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </span>
        )}
      </div>
      <span class="text-xs text-slate-500 dark:text-slate-300 mt-0.5 block truncate">
        {resource.category}
      </span>
    </div>

    <!-- Tool Description (Standardized 3-line Height via line-clamp-3 min-h-[3.75rem]) -->
    <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 line-clamp-3 min-h-[3.75rem] leading-relaxed overflow-hidden mt-1">
      {resource.description}
    </p>
  </div>

  <!-- Bottom Action Row: Pricing, Rating & Dynamic Action CTA -->
  <div class={`mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.05] flex items-center justify-between text-xs shrink-0 ${hasDetail ? 'relative z-10' : ''}`}>
    <div class="flex items-center gap-2">
      {resource.pricing && (
        <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">
          {resource.pricing}
        </span>
      )}
      <span class="text-[11px] font-medium text-slate-500 dark:text-slate-300">★ {resource.rating || '4.8'}</span>
    </div>

    {hasDetail ? (
      <div class="flex items-center gap-1.5">
        <a
          href={`/resources/${slug}`}
          class="inline-flex items-center gap-1 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-brand-orange transition-colors"
        >
          <span>View Details →</span>
        </a>
        <a
          href={resource.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1 rounded-md text-slate-400 hover:text-brand-orange hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-colors shrink-0"
          title={`Visit official ${resource.name} website`}
          aria-label={`Open official ${resource.name} site`}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    ) : isInternal ? (
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-brand-orange transition-colors">
        <span>Launch Tool →</span>
      </span>
    ) : (
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-brand-orange transition-colors">
        <span>Open Site ↗</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </span>
    )}
  </div>
</Tag>
