---
import type { DirectoryResource } from '../../data/navigation';
import { getMonogram, getMonogramGradient } from '../../utils/monogram';

interface Props {
  resource: DirectoryResource;
}

const { resource } = Astro.props;
const slug = resource.slug || resource.id;
const isInternal = Boolean(resource.internalUrl);
const hasDetail = resource.hasDetailPage === true;

let domain = resource.iconDomain || '';
if (!domain && resource.url && resource.url.startsWith('http')) {
  try {
    domain = new URL(resource.url).hostname.replace(/^www\./, '');
  } catch {}
}

const faviconUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128` : null;

// Determine Card Tag and Target:
// Standalone detail cards (hasDetailPage: true) use <div> with inner links.
// Direct external portal cards (hasDetailPage: false) use a single card-wide <a> link.
const Tag = hasDetail ? 'div' : 'a';
const outerHref = !hasDetail ? (isInternal ? resource.internalUrl : resource.url) : undefined;
const outerTarget = !hasDetail && !isInternal ? '_blank' : undefined;
const outerRel = !hasDetail && !isInternal ? 'noopener noreferrer' : undefined;
---

<Tag
  href={outerHref}
  target={outerTarget}
  rel={outerRel}
  class="bg-white dark:bg-dark-card border border-slate-200/80 dark:border-white/[0.08] hover:border-brand-orange/40 dark:hover:border-brand-orange/40 rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group relative"
>
  <!-- Card-wide overlay link for standalone pages (strictly pointing to /resources/${slug}) -->
  {hasDetail && (
    <a
      href={`/resources/${slug}`}
      class="absolute inset-0 z-0 rounded-2xl"
      aria-label={`View details for ${resource.name}`}
    />
  )}

  <!-- Top & Body Content -->
  <div class={`flex flex-col flex-1 ${hasDetail ? 'relative z-10 pointer-events-none' : ''}`}>
    <!-- Top Row: Logo (Left) + Badge (Right) -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <!-- Tool Icon Badge -->
      <div class="w-10 h-10 rounded-xl bg-slate-100/80 dark:bg-dark-elevated flex items-center justify-center text-slate-700 dark:text-slate-200 group-hover:scale-105 transition-transform shrink-0 relative overflow-hidden">
        {faviconUrl ? (
          <>
            <img
              src={faviconUrl}
              alt={`${resource.name} logo`}
              class="w-6 h-6 object-contain rounded-md"
              loading="lazy"
              onload="if (this.naturalHeight <= 16) { this.style.display='none'; this.nextElementSibling?.classList.remove('hidden'); }"
              onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
            />
            <!-- Fallback Styled 2-Letter Monogram Badge -->
            <div class={`hidden w-full h-full rounded-xl bg-gradient-to-br ${getMonogramGradient(resource.name)} flex items-center justify-center font-extrabold text-xs text-white select-none`}>
              {getMonogram(resource.name)}
            </div>
          </>
        ) : resource.iconName === 'calculator' ? (
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        ) : resource.iconName === 'factory' ? (
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        ) : resource.iconName === 'chart' ? (
          <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        ) : resource.iconName === 'trending' ? (
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        ) : resource.iconName === 'anchor' ? (
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v20m0 0l-4-4m4 4l4-4M6 6a6 6 0 0112 0" />
          </svg>
        ) : resource.iconName === 'activity' ? (
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        ) : resource.iconName === 'video' ? (
          <svg class="w-5 h-5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        ) : resource.iconName === 'sparkles' ? (
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        ) : resource.iconName === 'megaphone' ? (
          <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
          </svg>
        ) : resource.iconName === 'building' ? (
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        ) : resource.iconName === 'shield' ? (
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        ) : resource.iconName === 'scale' ? (
          <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        ) : (
          <div class={`w-full h-full rounded-xl bg-gradient-to-br ${getMonogramGradient(resource.name)} flex items-center justify-center font-extrabold text-xs text-white select-none`}>
            {getMonogram(resource.name)}
          </div>
        )}
      </div>

      <!-- Badges / Rating on Top-Right -->
      <div class="flex items-center gap-1.5 flex-wrap justify-end">
        {resource.badge && (
          <span class={`px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide border shrink-0 ${resource.badgeColor || 'bg-brand-orange/15 text-brand-orange border-brand-orange/30'}`}>
            {resource.badge}
          </span>
        )}
        {resource.pricing === 'Free' && (
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
            Free
          </span>
        )}
        {resource.pricing === 'Promo' && (
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-orange/15 text-brand-orange border border-brand-orange/30 shrink-0">
            {resource.discountText || 'Discount'}
          </span>
        )}
      </div>
    </div>

    <!-- Row 2: Full-width Title & Category -->
    <div class="mb-2 min-w-0">
      <div class="flex items-center gap-1.5 min-w-0">
        {hasDetail ? (
          <span class="text-base font-bold text-slate-900 dark:text-white leading-snug line-clamp-1 min-w-0 group-hover:text-brand-orange transition-colors">
            {resource.name}
          </span>
        ) : (
          <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug line-clamp-1 min-w-0 group-hover:text-brand-orange transition-colors">
            {resource.name}
          </h3>
        )}
        {resource.isVerified && (
          <span title="Verified Cross-Border Partner" class="text-emerald-500 shrink-0">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </span>
        )}
      </div>
      <div class="text-xs text-slate-500 dark:text-slate-300 mt-0.5 block truncate">
        {resource.category}
      </div>
    </div>

    <!-- Description (Standardized 3-line Height via line-clamp-3 min-h-[3.75rem]) -->
    <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 line-clamp-3 min-h-[3.75rem] leading-relaxed mt-1">
      {resource.description}
    </p>
  </div>

  <!-- Bottom Action Row -->
  <div class={`mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.04] flex items-center justify-between ${hasDetail ? 'relative z-10' : ''}`}>
    <div class="flex items-center gap-1 text-[11px] font-semibold text-slate-500 dark:text-slate-300">
      <span class="text-amber-500">★</span>
      <span>{resource.rating || '4.8'}</span>
    </div>

    {hasDetail ? (
      <!-- Standalone Page Cards: Dual Link Setup -->
      <div class="flex items-center">
        <!-- Main Internal Link Button strictly to /resources/${slug} -->
        <a
          href={`/resources/${slug}`}
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-brand-orange hover:bg-brand-orange/90 transition-all shadow-xs"
        >
          <span>View Details →</span>
        </a>
        <!-- Secondary External ↗ Button strictly to vendor url with distinct subtle border -->
        <a
          href={resource.url}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1.5 pl-2 border-l border-slate-200 dark:border-white/10 p-1.5 rounded-lg text-slate-400 hover:text-brand-orange hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-colors shrink-0"
          title={`Visit official ${resource.name} website`}
          aria-label={`Open official ${resource.name} site`}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    ) : isInternal ? (
      <!-- Internal Calculator / Tool Card -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-dark-elevated group-hover:bg-brand-orange group-hover:text-white dark:group-hover:bg-brand-orange dark:group-hover:text-white transition-all shadow-xs">
        <span>Launch Tool →</span>
      </span>
    ) : (
      <!-- Direct External Portal Card: Single clean link, no duplicate Unicode ↗ -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-dark-elevated group-hover:bg-brand-orange group-hover:text-white dark:group-hover:bg-brand-orange dark:group-hover:text-white transition-all shadow-xs">
        <span>Open Site</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </span>
    )}
  </div>
</Tag>
