---
import type { DirectoryResource } from '../../data/navigation';
import { getMonogram, getMonogramGradient } from '../../utils/monogram';

interface Props {
  resource: DirectoryResource;
}

const { resource } = Astro.props;

// Domain overrides for official corporate icons
const DOMAIN_OVERRIDES: Record<string, string> = {
  'google-trends': 'trends.google.com',
  'chatgpt-prompts': 'openai.com',
  'fba-calc': 'amazon.com',
  'amazon-bsr-us': 'amazon.com',
  'amazon-bsr-uk': 'amazon.co.uk',
  'amazon-bsr-de': 'amazon.de',
  'amazon-bsr-jp': 'amazon.co.jp',
  'amazon-bsr-ca': 'amazon.ca',
};

const COUNTRY_FLAGS: Record<string, string> = {
  'amazon-bsr-us': '🇺🇸',
  'amazon-bsr-uk': '🇬🇧',
  'amazon-bsr-de': '🇩🇪',
  'amazon-bsr-jp': '🇯🇵',
  'amazon-bsr-ca': '🇨🇦',
};

const countryFlag = COUNTRY_FLAGS[resource.id];

let domain = DOMAIN_OVERRIDES[resource.id] || '';
if (!domain && resource.url && resource.url.startsWith('http')) {
  try {
    domain = new URL(resource.url).hostname.replace(/^www\./, '');
  } catch {}
}

const isUtilityTool = [
  'length-converter',
  'temp-converter',
  'area-converter',
  'time-conversion',
  'ip-checker',
].includes(resource.id);

const faviconUrl = domain && !isUtilityTool
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64`
  : null;
---

<a
  href={resource.url}
  target="_blank"
  rel="noopener noreferrer"
  class="bg-white dark:bg-[#131924] border border-slate-200/90 dark:border-white/[0.08] hover:border-brand-orange/60 dark:hover:border-brand-orange/60 rounded-xl px-3 py-2.5 shadow-2xs hover:shadow-xs hover:bg-slate-50/60 dark:hover:bg-white/[0.03] transition-all flex items-center justify-between gap-2.5 group min-w-0"
  title={`${resource.name} — ${resource.description}`}
>
  <div class="flex items-center gap-2.5 min-w-0 flex-1">
    <!-- Icon Container (Border-free Clean Brand / Tool Asset) -->
    <div
      class="w-7 h-7 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform relative"
    >
      {faviconUrl ? (
        <>
          <img
            src={faviconUrl}
            alt={resource.name}
            class="w-6 h-6 object-contain rounded-xs"
            loading="lazy"
            onload="if (this.naturalHeight <= 16) { this.style.display='none'; this.nextElementSibling?.classList.remove('hidden'); }"
            onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
          />
          <!-- Fallback Monogram Badge -->
          <div class={`hidden w-6 h-6 rounded-md bg-gradient-to-br ${getMonogramGradient(resource.name)} flex items-center justify-center text-white font-bold text-[10px] select-none`}>
            {getMonogram(resource.name)}
          </div>
          {countryFlag && (
            <span class="absolute -bottom-1 -right-1 text-[10px] leading-none select-none drop-shadow-xs">
              {countryFlag}
            </span>
          )}
        </>
      ) : (
        <>
          {resource.id === 'temp-converter' && (
            <div class="w-7 h-7 bg-gradient-to-br from-rose-500 to-amber-500 text-white flex items-center justify-center rounded-lg p-1.5 shadow-2xs">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-none stroke-current" stroke-width="2.2">
                <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
              </svg>
            </div>
          )}
          {resource.id === 'length-converter' && (
            <div class="w-7 h-7 bg-gradient-to-br from-cyan-500 to-blue-600 text-white flex items-center justify-center rounded-lg p-1.5 shadow-2xs">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-none stroke-current" stroke-width="2.2">
                <path d="M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4z" />
              </svg>
            </div>
          )}
          {resource.id === 'area-converter' && (
            <div class="w-7 h-7 bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center rounded-lg p-1.5 shadow-2xs">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-none stroke-current" stroke-width="2.2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              </svg>
            </div>
          )}
          {resource.id === 'time-conversion' && (
            <div class="w-7 h-7 bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center rounded-lg p-1.5 shadow-2xs">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-none stroke-current" stroke-width="2.2">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
          )}
          {resource.id === 'ip-checker' && (
            <div class="w-7 h-7 bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center rounded-lg p-1.5 shadow-2xs">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-none stroke-current" stroke-width="2.2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
          )}
          {!['temp-converter', 'length-converter', 'area-converter', 'time-conversion', 'ip-checker'].includes(resource.id) && (
            <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-white/10 flex items-center justify-center text-xs font-bold text-slate-700 dark:text-slate-300 font-mono">
              {resource.name.charAt(0)}
            </div>
          )}
        </>
      )}
    </div>

    <!-- Tool Name (Readable 13px, NEVER truncated!) -->
    <span class="text-xs sm:text-[13px] font-semibold text-slate-800 dark:text-slate-100 group-hover:text-brand-orange transition-colors truncate">
      {resource.name}
    </span>
  </div>

  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-orange group-hover:translate-x-0.5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
</a>
