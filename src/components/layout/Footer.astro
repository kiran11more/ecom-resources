---

<footer class="w-full border-t border-slate-200/80 dark:border-white/[0.08] bg-white dark:bg-dark-card mt-12 sm:mt-16 transition-colors">
  <div class="max-w-[1820px] mx-auto px-3 sm:px-4 lg:px-5 py-10 sm:py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">
      <!-- Col 1: Brand & Live Status (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center shrink-0 group" aria-label="Ecom Resources Home">
          <img src="/logo.webp" alt="Ecom Resources" class="h-9 w-auto block dark:hidden" />
          <img src="/logo-dark.webp" alt="Ecom Resources" class="h-9 w-auto hidden dark:block" />
        </a>

        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed">
          The verified global directory and daily operational dashboard for cross-border e-commerce sellers, freight forwarders, and overseas brand builders.
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>500+ Verified Resources Active</span>
        </div>
      </div>

      <!-- Col 2: Top Directories -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Popular Tools
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href="#amazon-revenue-calculator" class="hover:text-brand-orange transition-colors">Amazon Revenue Calculator</a></li>
          <li><a href="#currency-exchange-rates" class="hover:text-brand-orange transition-colors">Currency Exchange Rates</a></li>
          <li><a href="#product-research" class="hover:text-brand-orange transition-colors">Amazon Best Seller Lists</a></li>
          <li><a href="#world-port-codes" class="hover:text-brand-orange transition-colors">World Port Codes (UN/LOCODE)</a></li>
          <li><a href="#chatgpt-prompts" class="hover:text-brand-orange transition-colors">E-Commerce AI Prompts</a></li>
        </ul>
      </div>

      <!-- Col 3: Sourcing & Logistics -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Ecosystem
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href="#sourcing" class="hover:text-brand-orange transition-colors">1688 Factory Wholesale</a></li>
          <li><a href="#warehouse-logistics" class="hover:text-brand-orange transition-colors">FBA Air & Ocean Freight</a></li>
          <li><a href="#videos-social" class="hover:text-brand-orange transition-colors">TikTok Shop US / UK</a></li>
          <li><a href="#legal-services" class="hover:text-brand-orange transition-colors">USPTO Trademark Registry</a></li>
          <li><a href="#advertising-platforms" class="hover:text-brand-orange transition-colors">Amazon & Google PPC</a></li>
        </ul>
      </div>

      <!-- Col 4: Stay Updated & Submit -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Partnerships
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Have a verified seller tool or cross-border agency? Join our curated directory.
        </p>
        <a
          href="#submit"
          class="inline-block w-full text-center bg-brand-orange hover:bg-brand-orangeHover text-white text-xs font-bold uppercase tracking-wider py-2 px-3 rounded-lg shadow-sm transition-colors"
        >
          Submit Resource
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-slate-100 dark:border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} Ecom Resources. All rights reserved.</p>
      <div class="flex items-center gap-4 text-xs">
        <a href="#privacy" class="hover:text-brand-orange transition-colors">Privacy Policy</a>
        <span>·</span>
        <a href="#terms" class="hover:text-brand-orange transition-colors">Terms of Service</a>
        <span>·</span>
        <a href="#contact" class="hover:text-brand-orange transition-colors">Contact Support</a>
      </div>
    </div>
  </div>
</footer>
